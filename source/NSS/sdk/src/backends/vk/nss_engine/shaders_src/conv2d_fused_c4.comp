#version 450
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_integer_dot_product : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : enable

                                                                                      
                                                                                    
                                                                                                  

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint in_width;
    uint in_height;
    uint out_width;
    uint out_height;
    uint in_channels;
    uint out_channels;
    int pad_y;
    int pad_x;
    int stride_y;
    int stride_x;
    int out_zp;
    int has_table;
    uint in1_channels;
    uint upsample;                                                            
} pc;

layout(std430, set = 0, binding = 0) readonly buffer InputBuffer {
    uvec4 in_data[];
};

layout(std430, set = 0, binding = 1) writeonly buffer OutputBuffer {
    uint out_data[];
};

layout(std430, set = 0, binding = 2) readonly buffer WeightBuffer {
    uint weight_data[];
};

layout(std430, set = 0, binding = 3) readonly buffer BiasBuffer {
    int32_t bias_data[];
};

layout(std430, set = 0, binding = 4) readonly buffer MultiplierBuffer {
    int32_t multiplier_data[];
};

layout(std430, set = 0, binding = 5) readonly buffer ShiftBuffer {
    int32_t shift_data[];
};

layout(std430, set = 0, binding = 6) readonly buffer TableBuffer {
    int8_t table_data[];
};

#define DP4A(a, b) dotPacked4x8EXT(int(a), int(b))
#define TILE 8
#define HALO (TILE + 2)                                           

shared uvec4 lds_in[HALO * HALO];

uvec4 loadInPixel(uint y, uint x) {
    uint p_in = (pc.upsample != 0u) ? ((y >> 1) * (pc.in_width >> 1) + (x >> 1)) : (y * pc.in_width + x);
    return in_data[p_in];
}

void main() {
    const uint tileX0 = gl_WorkGroupID.x * TILE;
    const uint tileY0 = gl_WorkGroupID.y * TILE;
    const uint lx = gl_LocalInvocationID.x;
    const uint ly = gl_LocalInvocationID.y;
    const uint tid = ly * TILE + lx;           

                                                                          
    for (uint cell = tid; cell < HALO * HALO; cell += TILE * TILE) {
        const uint cy = cell / HALO;
        const uint cx = cell % HALO;
        const int iy = int(tileY0) + int(cy) - pc.pad_y;
        const int ix = int(tileX0) + int(cx) - pc.pad_x;
        const bool inb = (iy >= 0) && (iy < int(pc.in_height)) && (ix >= 0) && (ix < int(pc.in_width));
        lds_in[cell] = inb ? loadInPixel(uint(iy), uint(ix)) : uvec4(0x80808080u);
    }
    barrier();

    const uint ox = tileX0 + lx;
    const uint oy = tileY0 + ly;
    if (ox >= pc.out_width || oy >= pc.out_height) return;

                                                                                   
    int32_t acc0 = 0;
    int32_t acc1 = 0;
    int32_t acc2 = 0;
    int32_t acc3 = 0;

    [[unroll]] for (uint ky = 0; ky < 3; ++ky) {
        [[unroll]] for (uint kx = 0; kx < 3; ++kx) {
            const uvec4 v = lds_in[(ly + ky) * HALO + (lx + kx)];
            const uint wtile = (ky * 3u + kx) * 64u;

                     
            acc0 += DP4A(v.x, weight_data[wtile + 0u])
                  + DP4A(v.y, weight_data[wtile + 16u])
                  + DP4A(v.z, weight_data[wtile + 32u])
                  + DP4A(v.w, weight_data[wtile + 48u]);

                     
            acc1 += DP4A(v.x, weight_data[wtile + 1u])
                  + DP4A(v.y, weight_data[wtile + 17u])
                  + DP4A(v.z, weight_data[wtile + 33u])
                  + DP4A(v.w, weight_data[wtile + 49u]);

                     
            acc2 += DP4A(v.x, weight_data[wtile + 2u])
                  + DP4A(v.y, weight_data[wtile + 18u])
                  + DP4A(v.z, weight_data[wtile + 34u])
                  + DP4A(v.w, weight_data[wtile + 50u]);

                     
            acc3 += DP4A(v.x, weight_data[wtile + 3u])
                  + DP4A(v.y, weight_data[wtile + 19u])
                  + DP4A(v.z, weight_data[wtile + 35u])
                  + DP4A(v.w, weight_data[wtile + 51u]);
        }
    }

                                                            
    int32_t hi, lo;

           
    imulExtended(acc0 + bias_data[0], multiplier_data[0], hi, lo);
    int32_t v0 = ((hi + (1 << (shift_data[0] - 33))) >> (shift_data[0] - 32)) + pc.out_zp;
    int8_t c0 = int8_t(clamp(v0, -128, 127));
    if (pc.has_table != 0) c0 = table_data[uint(int(c0) + 128)];

           
    imulExtended(acc1 + bias_data[1], multiplier_data[1], hi, lo);
    int32_t v1 = ((hi + (1 << (shift_data[1] - 33))) >> (shift_data[1] - 32)) + pc.out_zp;
    int8_t c1 = int8_t(clamp(v1, -128, 127));
    if (pc.has_table != 0) c1 = table_data[uint(int(c1) + 128)];

           
    imulExtended(acc2 + bias_data[2], multiplier_data[2], hi, lo);
    int32_t v2 = ((hi + (1 << (shift_data[2] - 33))) >> (shift_data[2] - 32)) + pc.out_zp;
    int8_t c2 = int8_t(clamp(v2, -128, 127));
    if (pc.has_table != 0) c2 = table_data[uint(int(c2) + 128)];

           
    imulExtended(acc3 + bias_data[3], multiplier_data[3], hi, lo);
    int32_t v3 = ((hi + (1 << (shift_data[3] - 33))) >> (shift_data[3] - 32)) + pc.out_zp;
    int8_t c3 = int8_t(clamp(v3, -128, 127));
    if (pc.has_table != 0) c3 = table_data[uint(int(c3) + 128)];

    uint packed_word = (uint(c0) & 0xFFu)
                     | ((uint(c1) & 0xFFu) << 8)
                     | ((uint(c2) & 0xFFu) << 16)
                     | ((uint(c3) & 0xFFu) << 24);

    out_data[oy * pc.out_width + ox] = packed_word;
}
