#version 450
#ifdef NFRU_DX12
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#endif
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_integer_dot_product : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : enable

                                                                                              
                                                                                              
                                                                                         
                                                                                                
                                                                                            
                                                                                               
                                                   
  
                                                                                         
                                                                     
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint in_width;
    uint in_height;
    uint out_width;
    uint out_height;
    uint in_channels;
    uint out_channels;
    int  pad_t;
    int  pad_l;
    int  stride_y;
    int  stride_x;
    uint kh;
    uint kw;
    int  out_zp;
    int  mult;
    int  shift;
    uint upsample;
} pc;

layout(std430, set = 0, binding = 0) readonly buffer InputBuffer   { uvec4 in_data[]; };
layout(std430, set = 0, binding = 1) writeonly buffer OutputBuffer { uint out_data[]; };
layout(std430, set = 0, binding = 2) readonly buffer WeightBuffer  { uint weight_data[]; };
layout(std430, set = 0, binding = 3) readonly buffer BiasBuffer    { int32_t bias_data[]; };

                                                                                                    
                                                                                                
                                                                                             
                                                                                               
                    
#define OCT 2
#define NOC (16 * OCT)
#define DP4A(a, b) dotPacked4x8EXT(int(a), int(b))
#define TILE 8
#define KH 5
#define KW 5
#define HALO (TILE + KH - 1)        

shared uvec4 lds_in[HALO * HALO];

void main() {
    const uint tileX0 = gl_WorkGroupID.x * TILE;
    const uint tileY0 = gl_WorkGroupID.y * TILE;
    const uint lx = gl_LocalInvocationID.x;
    const uint ly = gl_LocalInvocationID.y;
    const uint tid = ly * TILE + lx;

                                                                                            
    for (uint cell = tid; cell < HALO * HALO; cell += TILE * TILE) {
        const uint cy = cell / HALO;
        const uint cx = cell % HALO;
        const int iy = int(tileY0) + int(cy) - pc.pad_t;
        const int ix = int(tileX0) + int(cx) - pc.pad_l;
        const bool inb = (iy >= 0) && (iy < int(pc.in_height)) && (ix >= 0) && (ix < int(pc.in_width));
        lds_in[cell] = inb ? in_data[uint(iy) * pc.in_width + uint(ix)] : uvec4(0x80808080u);
    }
    barrier();

    const uint ox = tileX0 + lx;
    const uint oy = tileY0 + ly;
    const bool ok = (ox < pc.out_width) && (oy < pc.out_height);
    if (!ok) return;

    const uint nOc = pc.out_channels;                                                               

    int32_t acc[NOC];
    for (uint o = 0; o < NOC; ++o) acc[o] = 0;

    [[unroll]] for (uint ky = 0; ky < KH; ++ky) {
        [[unroll]] for (uint kx = 0; kx < KW; ++kx) {
            const uvec4 v = lds_in[(ly + ky) * HALO + (lx + kx)];
            const uint wtile = (ky * pc.kw + kx) * 64u;
            [[unroll]] for (uint o = 0; o < NOC; ++o) {
                if (o >= nOc) break;
                const uint wb = wtile + (o >> 4) * 64u + (o & 15u);
                acc[o] += DP4A(v.x, weight_data[wb])
                        + DP4A(v.y, weight_data[wb + 16u])
                        + DP4A(v.z, weight_data[wb + 32u])
                        + DP4A(v.w, weight_data[wb + 48u]);
            }
        }
    }

    const uint p = oy * pc.out_width + ox;
    const uint words_per_pixel = pc.out_channels / 4u;
    [[unroll]] for (uint w = 0; w < NOC / 4u; ++w) {
        if (w * 4u >= nOc) break;
        uint packed_word = 0u;
        [[unroll]] for (uint j = 0; j < 4u; ++j) {
            const uint o = w * 4u + j;
            if (o >= nOc) break;
            const int32_t a = acc[o] + bias_data[o];
            int32_t hi, lo;
            #ifdef NFRU_DX12
            { const int64_t prod = int64_t(a) * int64_t(pc.mult); hi = int32_t(prod >> 32); lo = int32_t(prod); }                              
#else
            imulExtended(a, pc.mult, hi, lo);
#endif
            const int32_t val = ((hi + (1 << (pc.shift - 33))) >> (pc.shift - 32)) + pc.out_zp;
            packed_word |= (uint(clamp(val, -128, 127)) & 0xFFu) << (8u * j);
        }
        out_data[p * words_per_pixel + w] = packed_word;
    }
}
