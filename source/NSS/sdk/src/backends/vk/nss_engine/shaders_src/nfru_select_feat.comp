#version 450
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 8, local_size_y = 8) in;
#include "nfru_select_common.h"
layout(set = 0, binding = 0, std430) readonly buffer Cand { uint cand[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Feat { float feat[]; };
                                                                                                                    
void main()
{
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.w || p.y >= pc.h) return;
    float f[29];
    for (int k = 0; k < 29; ++k) f[k] = 0.0;
    for (uint dy = 0u; dy < 4u; ++dy)
        for (uint dx = 0u; dx < 4u; ++dx) {
            uint base = ((p.y * 4u + dy) * pc.fw + p.x * 4u + dx) * 6u;
            vec3 c[6];
            for (uint i = 0u; i < 6u; ++i) c[i] = clamp(nfruUnpack(cand[base + i]), 0.0, 1.0);
            if (cand[base + 5u] == 0xffffffffu) c[5] = c[4];                                                
            for (int i = 0; i < 6; ++i) { f[i * 3] += c[i].r; f[i * 3 + 1] += c[i].g; f[i * 3 + 2] += c[i].b; }
            vec3 a = abs(c[0] - c[1]), b = abs(c[2] - c[3]);
            f[18] += a.r; f[19] += a.g; f[20] += a.b; f[21] += b.r; f[22] += b.g; f[23] += b.b;
            for (int i = 0; i < 5; ++i) { vec3 d = abs(c[i] - c[5]); f[24 + i] += max(max(d.r, d.g), d.b); }
        }
    uint o = (p.y * pc.w + p.x) * 29u;
    for (int k = 0; k < 29; ++k) feat[o + uint(k)] = f[k] * (1.0 / 16.0);
}
