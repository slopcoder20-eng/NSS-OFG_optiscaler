#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x_id=0) in;
layout(constant_id=3) const uint M=16;
layout(constant_id=4) const uint N=16;
layout(constant_id=5) const uint K=16;
#ifdef NFRU
layout(push_constant) uniform PC {
    uint iw,ih,ow,oh,ic,oc; int py,px,sy,sx;
    uint kh,kw; int zp,mult,shift; uint upsample;
} pc;
#else
layout(push_constant) uniform PC {
    uint iw,ih,ow,oh,ic,oc; int py,px,sy,sx;
    int zp,table; uint ic1,upsample;
} pc;
#endif
layout(std430,binding=0) readonly buffer Input { int8_t inputData[]; };
layout(std430,binding=1) writeonly buffer Output { int8_t outputData[]; };
layout(std430,binding=2) readonly buffer Weight { int8_t weights[]; };
layout(std430,binding=3) readonly buffer Bias { int bias[]; };
#ifndef NFRU
layout(std430,binding=4) readonly buffer Mult { int mult[]; };
layout(std430,binding=5) readonly buffer Shift { int shift[]; };
layout(std430,binding=6) readonly buffer Table { int8_t tableData[]; };
layout(std430,binding=7) readonly buffer Input2 { int8_t inputData2[]; };
#endif
shared int8_t aData[M*K];
shared int8_t bData[K*N];
shared int cData[M*N];
                                                                      
                                                                                    
shared int baseY[M];
shared int baseX[M];
int8_t readInput(int y,int x,uint c) {
    if(c>=pc.ic) return int8_t(0);
    if(y<0 || x<0 || y>=int(pc.ih) || x>=int(pc.iw)) return int8_t(-128);
    uint p=pc.upsample!=0 ? (uint(y)/2)*(pc.iw/2)+uint(x)/2 : uint(y)*pc.iw+uint(x);
#ifndef NFRU
    if(pc.ic1!=0) {
        if(c<pc.ic1) return inputData[p*pc.ic1+c];
        return inputData2[(uint(y)*pc.iw+uint(x))*(pc.ic-pc.ic1)+c-pc.ic1];
    }
#endif
    return inputData[p*pc.ic+c];
}
void main() {
    uint lane=gl_LocalInvocationIndex, lanes=gl_WorkGroupSize.x;
    uint pixelBase=gl_WorkGroupID.x*M, channelBase=gl_WorkGroupID.y*N;
    for(uint row=lane;row<M;row+=lanes) {
        uint p=pixelBase+row;
        baseY[row]=int(p/pc.ow)*pc.sy-pc.py;
        baseX[row]=int(p%pc.ow)*pc.sx-pc.px;
    }
    barrier();
    coopmat<int8_t,gl_ScopeSubgroup,M,K,gl_MatrixUseA> a;
    coopmat<int8_t,gl_ScopeSubgroup,K,N,gl_MatrixUseB> b;
    coopmat<int,gl_ScopeSubgroup,M,N,gl_MatrixUseAccumulator> acc=coopmat<int,gl_ScopeSubgroup,M,N,gl_MatrixUseAccumulator>(0);
#ifdef NFRU
    uint kh=pc.kh, kw=pc.kw;
#else
    uint kh=3, kw=3;
#endif
    uint ict=(pc.ic+15)/16, oct=(pc.oc+15)/16;
    for(uint ty=0;ty<kh;ty++) for(uint tx=0;tx<kw;tx++) for(uint kb=0;kb<pc.ic;kb+=K) {
        for(uint i=lane;i<M*K;i+=lanes) {
            uint p=pixelBase+i/K, c=kb+i%K;
            int y=baseY[i/K]+int(ty);
            int x=baseX[i/K]+int(tx);
            aData[i]=p<pc.ow*pc.oh ? readInput(y,x,c) : int8_t(0);
        }
        for(uint i=lane;i<K*N;i+=lanes) {
            uint c=kb+i/N, o=channelBase+i%N;
            uint wi=(((ty*kw+tx)*ict+c/16)*oct+o/16)*256+(c%16)*16+o%16;
            bData[i]=(c<pc.ic && o<pc.oc) ? weights[wi] : int8_t(0);
        }
        barrier();
        coopMatLoad(a,aData,0,K,gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(b,bData,0,N,gl_CooperativeMatrixLayoutRowMajor);
        acc=coopMatMulAdd(a,b,acc);
        barrier();
    }
    coopMatStore(acc,cData,0,N,gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for(uint i=lane;i<M*N;i+=lanes) {
        uint p=pixelBase+i/N, o=channelBase+i%N;
        if(p>=pc.ow*pc.oh || o>=pc.oc) continue;
        int value=cData[i]+bias[o], hi,lo;
#ifdef NFRU
        int mul=pc.mult, sh=pc.shift;
#else
        int mul=mult[o], sh=shift[o];
#endif
        imulExtended(value,mul,hi,lo);
        value=clamp(((hi+(1<<(sh-33)))>>(sh-32))+pc.zp,-128,127);
#ifndef NFRU
        if(pc.table!=0) value=int(tableData[value+128]);
#endif
        outputData[p*pc.oc+o]=int8_t(value);
    }
}
