    DUAL_ACC_CHAN_U(a0_4,  a1_4,  cur, nxt, (wb0) +  4u * kw_words); \
    DUAL_ACC_CHAN_U(a0_5,  a1_5,  cur, nxt, (wb0) +  5u * kw_words); \
    DUAL_ACC_CHAN_U(a0_6,  a1_6,  cur, nxt, (wb0) +  6u * kw_words); \
