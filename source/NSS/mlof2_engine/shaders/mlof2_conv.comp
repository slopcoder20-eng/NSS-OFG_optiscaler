    DUAL_ACC_CHAN_U(a0_11, a1_11, cur, nxt, (wb0) + 11u * kw_words); \
    DUAL_ACC_CHAN_U(a0_12, a1_12, cur, nxt, (wb0) + 12u * kw_words); \
    DUAL_ACC_CHAN_U(a0_13, a1_13, cur, nxt, (wb0) + 13u * kw_words); \
    DUAL_ACC_CHAN_U(a0_14, a1_14, cur, nxt, (wb0) + 14u * kw_words); \
    DUAL_ACC_CHAN_U(a0_15, a1_15, cur, nxt, (wb0) + 15u * kw_words); \
}

#define DUAL_ACC_4_A(cur, nxt, wb0) { \
    DUAL_ACC_CHAN_A(a0_0,  a1_0,  cur, nxt, (wb0) +  0u * kw_words); \
    DUAL_ACC_CHAN_A(a0_1,  a1_1,  cur, nxt, (wb0) +  1u * kw_words); \
    DUAL_ACC_CHAN_A(a0_2,  a1_2,  cur, nxt, (wb0) +  2u * kw_words); \
    DUAL_ACC_CHAN_A(a0_3,  a1_3,  cur, nxt, (wb0) +  3u * kw_words); \
}

