}

#define EMIT_BLOCK4(b, v0, v1, v2, v3, sc, bi, row_p, oy_p, ox_p) { \
    vec4 _y = vec4(v0, v1, v2, v3) * sc + bi; \
    if (res_t >= 0) { \
        vec4 r4 = segRead4(sres, row_p, oy_p, ox_p, oc0 + b); \
        if (res_c < 0) { _y += r4; } \
        _y = act == 1 ? max(_y, 0.1 * _y) : (act == 2 ? max(_y, vec4(0.0)) : _y); \
        if (res_c >= 0) { _y += r4; } \
    } else { \
        _y = act == 1 ? max(_y, 0.1 * _y) : (act == 2 ? max(_y, vec4(0.0)) : _y); \
    } \
    if (((out_coff + oc0 + b) & 3u) == 0u) { \
        tensorWrite4(to, row_p, oy_p, ox_p, out_coff + oc0 + b, _y); \
    } else { \
        tensorWrite(to, row_p, oy_p, ox_p, out_coff + oc0 + b + 0u, _y.x); \
        tensorWrite(to, row_p, oy_p, ox_p, out_coff + oc0 + b + 1u, _y.y); \
        tensorWrite(to, row_p, oy_p, ox_p, out_coff + oc0 + b + 2u, _y.z); \
        tensorWrite(to, row_p, oy_p, ox_p, out_coff + oc0 + b + 3u, _y.w); \
    } \
}

                                                 
void main() {
    uint out_c = opw(OP_OUT_C);
                                                                                                                     
                                                                                         
#ifdef MLOF2_DX
    const uint ocg = 16u;                                                                    
#else
    const uint ocg = gl_NumWorkGroups.y > (out_c + 15u) / 16u ? 4u : 16u;
#endif
    uint oc0 = gl_GlobalInvocationID.y * ocg;
    if (oc0 >= out_c) return;

    Tensor to = tensorAt(opw(OP_OUT));
    uint hw = to.h * to.w;
    uint total_pix = to.n * hw;

    uint pix_a = gl_GlobalInvocationID.x * 2u;
    uint pix_b = pix_a + 1u;
    if (pix_a >= total_pix) return;
    bool has_b = (pix_b < total_pix);

    uint row_a = pix_a / hw, rem_a = pix_a % hw;
    int oy_a = int(rem_a / to.w), ox_a = int(rem_a % to.w);

    uint row_b = 0u;
    int oy_b = 0, ox_b = 0;
    if (has_b) {
        row_b = pix_b / hw;
        uint rem_b = pix_b % hw;
        oy_b = int(rem_b / to.w);
        ox_b = int(rem_b % to.w);
    }

    int kh = opi(0), kw = opi(1), stride = opi(2), pad = opi(3), dil = opi(4);
    uint w_off = opw(OP_W_OFF), kw_words = opw(OP_KW_WORDS);
    uint icw = (kh == 1 && kw == 1) ? kw_words : (kw_words / uint(kh * kw));
    uint nseg = opw(OP_NSEG);
    uint noc = min(ocg, out_c - oc0);

                           
    int a0_0 = 0, a0_1 = 0, a0_2 = 0, a0_3 = 0, a0_4 = 0, a0_5 = 0, a0_6 = 0, a0_7 = 0;
    int a0_8 = 0, a0_9 = 0, a0_10 = 0, a0_11 = 0, a0_12 = 0, a0_13 = 0, a0_14 = 0, a0_15 = 0;

                           
    int a1_0 = 0, a1_1 = 0, a1_2 = 0, a1_3 = 0, a1_4 = 0, a1_5 = 0, a1_6 = 0, a1_7 = 0;
    int a1_8 = 0, a1_9 = 0, a1_10 = 0, a1_11 = 0, a1_12 = 0, a1_13 = 0, a1_14 = 0, a1_15 = 0;

    bool is_1x1 = (kh == 1 && kw == 1 && stride == 1 && pad == 0);

    bool can_slide_3x3 = (kh == 3 && kw == 3 && stride == 1 && dil == 1 && to.w >= 2u && has_b && row_a == row_b && oy_a == oy_b && ox_b == ox_a + 1);
    bool can_slide_3x3_dil2 = (kh == 3 && kw == 3 && stride == 1 && dil == 2 && to.w >= 2u && has_b && row_a == row_b && oy_a == oy_b && ox_b == ox_a + 1);
    bool can_slide_3x3_s2 = (kh == 3 && kw == 3 && stride == 2 && dil == 1 && to.w >= 2u && has_b && row_a == row_b && oy_a == oy_b && ox_b == ox_a + 1);
    bool can_slide_kxk = ((kh == 5 && kw == 5) || (kh == 7 && kw == 7)) && (stride == 1 && dil == 1 && to.w >= 2u && has_b && row_a == row_b && oy_a == oy_b && ox_b == ox_a + 1);

    if (is_1x1) {
                                            
        uint w_base_oc = w_off + oc0 * kw_words;

        if (noc <= 4u) {
            uint gw_base = 0u;
            for (uint si = 0u; si < nseg; ++si) {
                Seg s = segAt(si);
                uint srow_a = srcRow(s, row_a);
                uint srow_b = has_b ? srcRow(s, row_b) : 0u;
                uint byte_base_a = s.t.base + ((srow_a * s.t.h + uint(oy_a)) * s.t.w + uint(ox_a)) * s.t.c_alloc + s.c_off;
                uint byte_base_b = has_b ? (s.t.base + ((srow_b * s.t.h + uint(oy_b)) * s.t.w + uint(ox_b)) * s.t.c_alloc + s.c_off) : 0u;

                uint c = 0u;
                if ((byte_base_a & 15u) == 0u) {
                    bool w_align = ((w_base_oc | gw_base | kw_words) & 3u) == 0u;
                    if (w_align) {
                        for (; c + 16u <= s.c; c += 16u) {
                            uvec4 xq4_a = ldv4((byte_base_a + c) >> 4u);
                            uvec4 xq4_b = has_b ? ldv4((byte_base_b + c) >> 4u) : uvec4(0u);
                            uint wb0 = w_base_oc + gw_base + (c >> 2u);
                            DUAL_ACC_4_A(xq4_a, xq4_b, wb0);
                        }
                    } else {
                        for (; c + 16u <= s.c; c += 16u) {
                            uvec4 xq4_a = ldv4((byte_base_a + c) >> 4u);
                            uvec4 xq4_b = has_b ? ldv4((byte_base_b + c) >> 4u) : uvec4(0u);
                            uint wb0 = w_base_oc + gw_base + (c >> 2u);
                            DUAL_ACC_4_U(xq4_a, xq4_b, wb0);
                        }
                    }
                }
                uint u32_base_a = byte_base_a >> 2u;
                uint u32_base_b = byte_base_b >> 2u;
                uint full_c = s.c & ~3u;
                for (; c < full_c; c += 4u) {
                    uint xq_a = arena_u32[u32_base_a + (c >> 2u)];
                    uint xq_b = has_b ? arena_u32[u32_base_b + (c >> 2u)] : 0u;
                    uint wb = w_base_oc + gw_base + (c >> 2u);
                    DUAL_ACC_4(xq_a, xq_b, wb);
                }

                if (full_c < s.c) {
                    uint rem_c = s.c - full_c;
                    uint mask = (1u << (rem_c * 8u)) - 1u;
                    uint xq_a = arena_u32[u32_base_a + (full_c >> 2u)] & mask;
                    uint xq_b = has_b ? (arena_u32[u32_base_b + (full_c >> 2u)] & mask) : 0u;
                    uint wb = w_base_oc + gw_base + (full_c >> 2u);
                    DUAL_ACC_4(xq_a, xq_b, wb);
                }
                gw_base += (s.c + 3u) / 4u;
            }
        } else {
            uint gw_base = 0u;
            for (uint si = 0u; si < nseg; ++si) {
                Seg s = segAt(si);
                uint srow_a = srcRow(s, row_a);
                uint srow_b = has_b ? srcRow(s, row_b) : 0u;
                uint byte_base_a = s.t.base + ((srow_a * s.t.h + uint(oy_a)) * s.t.w + uint(ox_a)) * s.t.c_alloc + s.c_off;
                uint byte_base_b = has_b ? (s.t.base + ((srow_b * s.t.h + uint(oy_b)) * s.t.w + uint(ox_b)) * s.t.c_alloc + s.c_off) : 0u;

                uint c = 0u;
                if ((byte_base_a & 15u) == 0u) {
                    bool w_align = ((w_base_oc | gw_base | kw_words) & 3u) == 0u;
                    if (w_align) {
                        for (; c + 16u <= s.c; c += 16u) {
                            uvec4 xq4_a = ldv4((byte_base_a + c) >> 4u);
                            uvec4 xq4_b = has_b ? ldv4((byte_base_b + c) >> 4u) : uvec4(0u);
                            uint wb0 = w_base_oc + gw_base + (c >> 2u);
                            DUAL_ACC_16_A(xq4_a, xq4_b, wb0);
                        }
                    } else {
                        for (; c + 16u <= s.c; c += 16u) {
                            uvec4 xq4_a = ldv4((byte_base_a + c) >> 4u);
                            uvec4 xq4_b = has_b ? ldv4((byte_base_b + c) >> 4u) : uvec4(0u);
                            uint wb0 = w_base_oc + gw_base + (c >> 2u);
                            DUAL_ACC_16_U(xq4_a, xq4_b, wb0);
                        }
                    }
                }
                uint u32_base_a = byte_base_a >> 2u;
                uint u32_base_b = byte_base_b >> 2u;
                uint full_c = s.c & ~3u;
                for (; c < full_c; c += 4u) {
                    uint xq_a = arena_u32[u32_base_a + (c >> 2u)];
                    uint xq_b = has_b ? arena_u32[u32_base_b + (c >> 2u)] : 0u;
                    uint wb = w_base_oc + gw_base + (c >> 2u);
                    DUAL_ACC_16(xq_a, xq_b, wb);
                }

                if (full_c < s.c) {
                    uint rem_c = s.c - full_c;
                    uint mask = (1u << (rem_c * 8u)) - 1u;
