#version 450
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_integer_dot_product : enable
#extension GL_GOOGLE_include_directive : enable
                                            
                                                                                                              
                                                                                                                    
                                                                                                         
                                                           
                                                                            
                                     
#include "mlof2_common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define DOT4(a, b) dotPacked4x8EXT(int(a), int(b))
#ifdef MLOF2_DX
#define ACC4(acc, a, b) acc += DOT4(a, b)
#else
#define ACC4(acc, a, b) acc = dotPacked4x8AccSatEXT(int(a), int(b), acc)
#endif

                                                                                      
#define DUAL_ACC_4(xq_a, xq_b, wb) { \
    uint w0 = blob[wb + 0u * kw_words]; \
    uint w1 = blob[wb + 1u * kw_words]; \
    uint w2 = blob[wb + 2u * kw_words]; \
    uint w3 = blob[wb + 3u * kw_words]; \
    ACC4(a0_0, xq_a, w0); ACC4(a1_0, xq_b, w0); \
    ACC4(a0_1, xq_a, w1); ACC4(a1_1, xq_b, w1); \
    ACC4(a0_2, xq_a, w2); ACC4(a1_2, xq_b, w2); \
    ACC4(a0_3, xq_a, w3); ACC4(a1_3, xq_b, w3); \
}

                                           
#define DUAL_ACC_16(xq_a, xq_b, wb) { \
    DUAL_ACC_4(xq_a, xq_b, wb); \
    uint w4  = blob[wb +  4u * kw_words]; \
    uint w5  = blob[wb +  5u * kw_words]; \
    uint w6  = blob[wb +  6u * kw_words]; \
    uint w7  = blob[wb +  7u * kw_words]; \
    uint w8  = blob[wb +  8u * kw_words]; \
    uint w9  = blob[wb +  9u * kw_words]; \
    uint w10 = blob[wb + 10u * kw_words]; \
    uint w11 = blob[wb + 11u * kw_words]; \
    uint w12 = blob[wb + 12u * kw_words]; \
    uint w13 = blob[wb + 13u * kw_words]; \
    uint w14 = blob[wb + 14u * kw_words]; \
    uint w15 = blob[wb + 15u * kw_words]; \
    ACC4(a0_4 , xq_a, w4 ); ACC4(a1_4 , xq_b, w4 ); \
    ACC4(a0_5 , xq_a, w5 ); ACC4(a1_5 , xq_b, w5 ); \
    ACC4(a0_6 , xq_a, w6 ); ACC4(a1_6 , xq_b, w6 ); \
    ACC4(a0_7 , xq_a, w7 ); ACC4(a1_7 , xq_b, w7 ); \
    ACC4(a0_8 , xq_a, w8 ); ACC4(a1_8 , xq_b, w8 ); \
    ACC4(a0_9 , xq_a, w9 ); ACC4(a1_9 , xq_b, w9 ); \
    ACC4(a0_10, xq_a, w10); ACC4(a1_10, xq_b, w10); \
    ACC4(a0_11, xq_a, w11); ACC4(a1_11, xq_b, w11); \
    ACC4(a0_12, xq_a, w12); ACC4(a1_12, xq_b, w12); \
    ACC4(a0_13, xq_a, w13); ACC4(a1_13, xq_b, w13); \
    ACC4(a0_14, xq_a, w14); ACC4(a1_14, xq_b, w14); \
    ACC4(a0_15, xq_a, w15); ACC4(a1_15, xq_b, w15); \
}

#define DUAL_ACC_CHAN(acc_a, acc_b, cur, nxt, w_idx) { \
    uvec4 w_oc = ldb4(w_idx); \
    ACC4(acc_a, cur.x, w_oc.x); \
    ACC4(acc_a, cur.y, w_oc.y); \
    ACC4(acc_a, cur.z, w_oc.z); \
    ACC4(acc_a, cur.w, w_oc.w); \
    ACC4(acc_b, nxt.x, w_oc.x); \
    ACC4(acc_b, nxt.y, w_oc.y); \
    ACC4(acc_b, nxt.z, w_oc.z); \
    ACC4(acc_b, nxt.w, w_oc.w); \
}

#define DUAL_ACC_16_VEC(cur, nxt, w_base, stride) { \
    DUAL_ACC_CHAN(a0_0,  a1_0,  cur, nxt, (w_base) +  0u * (stride)); \
    DUAL_ACC_CHAN(a0_1,  a1_1,  cur, nxt, (w_base) +  1u * (stride)); \
    DUAL_ACC_CHAN(a0_2,  a1_2,  cur, nxt, (w_base) +  2u * (stride)); \
    DUAL_ACC_CHAN(a0_3,  a1_3,  cur, nxt, (w_base) +  3u * (stride)); \
    DUAL_ACC_CHAN(a0_4,  a1_4,  cur, nxt, (w_base) +  4u * (stride)); \
    DUAL_ACC_CHAN(a0_5,  a1_5,  cur, nxt, (w_base) +  5u * (stride)); \
    DUAL_ACC_CHAN(a0_6,  a1_6,  cur, nxt, (w_base) +  6u * (stride)); \
    DUAL_ACC_CHAN(a0_7,  a1_7,  cur, nxt, (w_base) +  7u * (stride)); \
    DUAL_ACC_CHAN(a0_8,  a1_8,  cur, nxt, (w_base) +  8u * (stride)); \
    DUAL_ACC_CHAN(a0_9,  a1_9,  cur, nxt, (w_base) +  9u * (stride)); \
    DUAL_ACC_CHAN(a0_10, a1_10, cur, nxt, (w_base) + 10u * (stride)); \
    DUAL_ACC_CHAN(a0_11, a1_11, cur, nxt, (w_base) + 11u * (stride)); \
    DUAL_ACC_CHAN(a0_12, a1_12, cur, nxt, (w_base) + 12u * (stride)); \
    DUAL_ACC_CHAN(a0_13, a1_13, cur, nxt, (w_base) + 13u * (stride)); \
    DUAL_ACC_CHAN(a0_14, a1_14, cur, nxt, (w_base) + 14u * (stride)); \
    DUAL_ACC_CHAN(a0_15, a1_15, cur, nxt, (w_base) + 15u * (stride)); \
}

#define DUAL_ACC_4_VEC(cur, nxt, w_base, stride) { \
    DUAL_ACC_CHAN(a0_0,  a1_0,  cur, nxt, (w_base) +  0u * (stride)); \
    DUAL_ACC_CHAN(a0_1,  a1_1,  cur, nxt, (w_base) +  1u * (stride)); \
    DUAL_ACC_CHAN(a0_2,  a1_2,  cur, nxt, (w_base) +  2u * (stride)); \
    DUAL_ACC_CHAN(a0_3,  a1_3,  cur, nxt, (w_base) +  3u * (stride)); \
}

#define DUAL_ACC_CHAN_A(acc_a, acc_b, cur, nxt, p) { \
    uvec4 _w4 = ldb4((p) >> 2u); \
    ACC4(acc_a, cur.x, _w4.x); \
    ACC4(acc_a, cur.y, _w4.y); \
    ACC4(acc_a, cur.z, _w4.z); \
    ACC4(acc_a, cur.w, _w4.w); \
    ACC4(acc_b, nxt.x, _w4.x); \
    ACC4(acc_b, nxt.y, _w4.y); \
    ACC4(acc_b, nxt.z, _w4.z); \
    ACC4(acc_b, nxt.w, _w4.w); \
}

#define DUAL_ACC_CHAN_U(acc_a, acc_b, cur, nxt, p) { \
    uvec4 _w4 = uvec4(blob[(p)], blob[(p) + 1u], blob[(p) + 2u], blob[(p) + 3u]); \
    ACC4(acc_a, cur.x, _w4.x); \
    ACC4(acc_a, cur.y, _w4.y); \
    ACC4(acc_a, cur.z, _w4.z); \
    ACC4(acc_a, cur.w, _w4.w); \
    ACC4(acc_b, nxt.x, _w4.x); \
    ACC4(acc_b, nxt.y, _w4.y); \
    ACC4(acc_b, nxt.z, _w4.z); \
    ACC4(acc_b, nxt.w, _w4.w); \
}

#define DUAL_ACC_16_A(cur, nxt, wb0) { \
    DUAL_ACC_CHAN_A(a0_0,  a1_0,  cur, nxt, (wb0) +  0u * kw_words); \
    DUAL_ACC_CHAN_A(a0_1,  a1_1,  cur, nxt, (wb0) +  1u * kw_words); \
    DUAL_ACC_CHAN_A(a0_2,  a1_2,  cur, nxt, (wb0) +  2u * kw_words); \
    DUAL_ACC_CHAN_A(a0_3,  a1_3,  cur, nxt, (wb0) +  3u * kw_words); \
    DUAL_ACC_CHAN_A(a0_4,  a1_4,  cur, nxt, (wb0) +  4u * kw_words); \
    DUAL_ACC_CHAN_A(a0_5,  a1_5,  cur, nxt, (wb0) +  5u * kw_words); \
    DUAL_ACC_CHAN_A(a0_6,  a1_6,  cur, nxt, (wb0) +  6u * kw_words); \
    DUAL_ACC_CHAN_A(a0_7,  a1_7,  cur, nxt, (wb0) +  7u * kw_words); \
    DUAL_ACC_CHAN_A(a0_8,  a1_8,  cur, nxt, (wb0) +  8u * kw_words); \
    DUAL_ACC_CHAN_A(a0_9,  a1_9,  cur, nxt, (wb0) +  9u * kw_words); \
    DUAL_ACC_CHAN_A(a0_10, a1_10, cur, nxt, (wb0) + 10u * kw_words); \
    DUAL_ACC_CHAN_A(a0_11, a1_11, cur, nxt, (wb0) + 11u * kw_words); \
    DUAL_ACC_CHAN_A(a0_12, a1_12, cur, nxt, (wb0) + 12u * kw_words); \
    DUAL_ACC_CHAN_A(a0_13, a1_13, cur, nxt, (wb0) + 13u * kw_words); \
    DUAL_ACC_CHAN_A(a0_14, a1_14, cur, nxt, (wb0) + 14u * kw_words); \
    DUAL_ACC_CHAN_A(a0_15, a1_15, cur, nxt, (wb0) + 15u * kw_words); \
}

#define DUAL_ACC_16_U(cur, nxt, wb0) { \
    DUAL_ACC_CHAN_U(a0_0,  a1_0,  cur, nxt, (wb0) +  0u * kw_words); \
