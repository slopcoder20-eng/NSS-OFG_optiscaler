                        uint c_w = c >> 2u;
                        int col_cur = ix0 + 0;
                        bool in_cur = (col_cur >= 0 && col_cur < int(s.t.w));
                        uint cur = in_cur ? arena_u32[(y_base + uint(col_cur) * px_stride + c) >> 2u] : 0u;

                        for (int kx = 0; kx < kw; ++kx) {
                            int col_nxt = ix0 + kx + 1;
                            bool in_nxt = (col_nxt >= 0 && col_nxt < int(s.t.w));
                            uint nxt = in_nxt ? arena_u32[(y_base + uint(col_nxt) * px_stride + c) >> 2u] : 0u;

                            uint w_tap = w_off + oc0 * kw_words + (uint(ky * kw + kx)) * icw + gw_base + c_w;
                            DUAL_ACC_16(cur, nxt, w_tap);
                            cur = nxt;
                        }
                    }
                    if (c < s.c) {
                        uint rem_c = s.c - c;
                        uint mask = (1u << (rem_c * 8u)) - 1u;
                        uint c_w = c >> 2u;
                        int col_cur = ix0 + 0;
                        bool in_cur = (col_cur >= 0 && col_cur < int(s.t.w));
                        uint cur = in_cur ? (arena_u32[(y_base + uint(col_cur) * px_stride + c) >> 2u] & mask) : 0u;

                        for (int kx = 0; kx < kw; ++kx) {
                            int col_nxt = ix0 + kx + 1;
                            bool in_nxt = (col_nxt >= 0 && col_nxt < int(s.t.w));
                            uint nxt = in_nxt ? (arena_u32[(y_base + uint(col_nxt) * px_stride + c) >> 2u] & mask) : 0u;

                            uint w_tap = w_off + oc0 * kw_words + (uint(ky * kw + kx)) * icw + gw_base + c_w;
                            DUAL_ACC_16(cur, nxt, w_tap);
                            cur = nxt;
                        }
                    }

                    gw_base += (s.c + 3u) / 4u;
                }
            }
        }
    } else {
                                                   
        int iy0_a = oy_a * stride - pad, ix0_a = ox_a * stride - pad;
        int iy0_b = oy_b * stride - pad, ix0_b = ox_b * stride - pad;

        if (noc <= 4u) {
            for (int ky = 0; ky < kh; ++ky) {
                int iy_a = iy0_a + ky * dil, iy_b = iy0_b + ky * dil;
                for (int kx = 0; kx < kw; ++kx) {
                    int ix_a = ix0_a + kx * dil, ix_b = ix0_b + kx * dil;
                    uint tap = uint(ky * kw + kx);
                    uint w_tap_base = w_off + oc0 * kw_words + tap * icw;

                    uint gw_base = 0u;
                    for (uint si = 0u; si < nseg; ++si) {
                        Seg s = segAt(si);
                        bool inb_a = (iy_a >= 0 && iy_a < int(s.t.h) && ix_a >= 0 && ix_a < int(s.t.w));
                        bool inb_b = (has_b && iy_b >= 0 && iy_b < int(s.t.h) && ix_b >= 0 && ix_b < int(s.t.w));

                        if (inb_a || inb_b) {
                            uint safe_y_a = inb_a ? uint(iy_a) : 0u, safe_x_a = inb_a ? uint(ix_a) : 0u;
                            uint safe_y_b = inb_b ? uint(iy_b) : 0u, safe_x_b = inb_b ? uint(ix_b) : 0u;
                            uint srow_a = srcRow(s, row_a);
                            uint srow_b = has_b ? srcRow(s, row_b) : 0u;

                            uint byte_base_a = s.t.base + ((srow_a * s.t.h + safe_y_a) * s.t.w + safe_x_a) * s.t.c_alloc + s.c_off;
                            uint byte_base_b = s.t.base + ((srow_b * s.t.h + safe_y_b) * s.t.w + safe_x_b) * s.t.c_alloc + s.c_off;

                            uint c = 0u;
                            if ((byte_base_a & 15u) == 0u) {
                                bool can_v16 = ((w_tap_base | gw_base | kw_words) & 3u) == 0u;
                                uint kw_stride = kw_words >> 2u;
                                for (; c + 16u <= s.c; c += 16u) {
                                    uvec4 xq4_a = inb_a ? ldv4((byte_base_a + c) >> 4u) : uvec4(0u);
                                    uvec4 xq4_b = inb_b ? ldv4((byte_base_b + c) >> 4u) : uvec4(0u);
                                    uint wb0 = w_tap_base + gw_base + (c >> 2u);
                                    if (can_v16) {
                                        DUAL_ACC_4_VEC(xq4_a, xq4_b, wb0 >> 2u, kw_stride);
                                    } else {
                                        DUAL_ACC_4_U(xq4_a, xq4_b, wb0);
                                    }
                                }
                            }

                            uint u32_base_a = byte_base_a >> 2u;
                            uint u32_base_b = byte_base_b >> 2u;
                            uint full_c = s.c & ~3u;
                            for (; c < full_c; c += 4u) {
                                uint xq_a = inb_a ? arena_u32[u32_base_a + (c >> 2u)] : 0u;
                                uint xq_b = inb_b ? arena_u32[u32_base_b + (c >> 2u)] : 0u;
                                uint wb = w_tap_base + gw_base + (c >> 2u);
                                DUAL_ACC_4(xq_a, xq_b, wb);
                            }

                            if (full_c < s.c) {
                                uint rem_c = s.c - full_c;
                                uint mask = (1u << (rem_c * 8u)) - 1u;
                                uint xq_a = inb_a ? (arena_u32[u32_base_a + (full_c >> 2u)] & mask) : 0u;
                                uint xq_b = inb_b ? (arena_u32[u32_base_b + (full_c >> 2u)] & mask) : 0u;
                                uint wb = w_tap_base + gw_base + (full_c >> 2u);
                                DUAL_ACC_4(xq_a, xq_b, wb);
                            }
                        }
                        gw_base += (s.c + 3u) / 4u;
                    }
                }
            }
        } else {
            Seg s0 = segAt(0u);
            bool is_interior = (has_b && row_a == row_b && oy_a == oy_b && ox_b == ox_a + 1 && nseg == 1u &&
                                iy0_a >= 0 && iy0_a + (kh - 1) * dil < int(s0.t.h) &&
                                ix0_a >= 0 && ix0_b + (kw - 1) * dil < int(s0.t.w));

            if (is_interior) {
                uint srow = srcRow(s0, row_a);
                uint px_stride = s0.t.c_alloc;
                uint y_stride = uint(dil) * s0.t.w * px_stride;
                uint x_stride = uint(dil) * px_stride;
                uint base_a = s0.t.base + (srow * s0.t.h + uint(iy0_a)) * s0.t.w * px_stride + uint(ix0_a) * px_stride + s0.c_off;

                if (dil == 1 && s0.c == 16u && (px_stride & 15u) == 0u && ((w_off | kw_words) & 3u) == 0u) {
                    uint kw_stride = kw_words >> 2u;
                    uint w_v4_ptr = (w_off + oc0 * kw_words) >> 2u;
                    if (noc <= 4u) {
                        for (int ky = 0; ky < kh; ++ky) {
                            uint row_addr = base_a + uint(ky) * y_stride;
                            uvec4 cur = ldv4(row_addr >> 4u);
                            for (int kx = 0; kx < kw; ++kx) {
                                row_addr += px_stride;
                                uvec4 nxt = ldv4(row_addr >> 4u);
                                DUAL_ACC_4_VEC(cur, nxt, w_v4_ptr, kw_stride);
                                cur = nxt;
                                w_v4_ptr += 1u;
                            }
                        }
                    } else {
                        for (int ky = 0; ky < kh; ++ky) {
                            uint row_addr = base_a + uint(ky) * y_stride;
                            uvec4 cur = ldv4(row_addr >> 4u);
                            for (int kx = 0; kx < kw; ++kx) {
                                row_addr += px_stride;
                                uvec4 nxt = ldv4(row_addr >> 4u);
                                DUAL_ACC_16_VEC(cur, nxt, w_v4_ptr, kw_stride);
                                cur = nxt;
                                w_v4_ptr += 1u;
                            }
                        }
                    }
                } else if (dil == 1 && s0.c == 32u && (px_stride & 15u) == 0u && ((w_off | kw_words) & 3u) == 0u) {
                    uint kw_stride = kw_words >> 2u;
                    uint w_v4_ptr = (w_off + oc0 * kw_words) >> 2u;
                    if (noc <= 4u) {
                        for (int ky = 0; ky < kh; ++ky) {
                            uint row_addr = base_a + uint(ky) * y_stride;
                            uvec4 cur0 = ldv4(row_addr >> 4u);
                            uvec4 cur1 = ldv4((row_addr + 16u) >> 4u);
                            for (int kx = 0; kx < kw; ++kx) {
                                row_addr += px_stride;
                                uvec4 nxt0 = ldv4(row_addr >> 4u);
                                uvec4 nxt1 = ldv4((row_addr + 16u) >> 4u);
                                DUAL_ACC_4_VEC(cur0, nxt0, w_v4_ptr + 0u, kw_stride);
                                DUAL_ACC_4_VEC(cur1, nxt1, w_v4_ptr + 1u, kw_stride);
                                cur0 = nxt0;
                                cur1 = nxt1;
                                w_v4_ptr += 2u;
                            }
                        }
                    } else {
                        for (int ky = 0; ky < kh; ++ky) {
                            uint row_addr = base_a + uint(ky) * y_stride;
                            uvec4 cur0 = ldv4(row_addr >> 4u);
                            uvec4 cur1 = ldv4((row_addr + 16u) >> 4u);
                            for (int kx = 0; kx < kw; ++kx) {
                                row_addr += px_stride;
                                uvec4 nxt0 = ldv4(row_addr >> 4u);
                                uvec4 nxt1 = ldv4((row_addr + 16u) >> 4u);
                                DUAL_ACC_16_VEC(cur0, nxt0, w_v4_ptr + 0u, kw_stride);
                                DUAL_ACC_16_VEC(cur1, nxt1, w_v4_ptr + 1u, kw_stride);
                                cur0 = nxt0;
                                cur1 = nxt1;
                                w_v4_ptr += 2u;
                            }
                        }
                    }
                } else {
                    for (int ky = 0; ky < kh; ++ky) {
                        uint row_addr_a = base_a + uint(ky) * y_stride;
                        for (int kx = 0; kx < kw; ++kx) {
                            uint tap_a = row_addr_a + uint(kx) * x_stride;
                            uint tap_b = tap_a + px_stride;
                            uint tap = uint(ky * kw + kx);
                            uint w_tap_base = w_off + oc0 * kw_words + tap * icw;

                            uint c = 0u;
                            if ((px_stride & 15u) == 0u) {
                                bool can_v16 = ((w_tap_base | kw_words) & 3u) == 0u;
                                uint kw_stride = kw_words >> 2u;
                                for (; c + 16u <= s0.c; c += 16u) {
                                    uvec4 xq4_a = ldv4((tap_a + c) >> 4u);
                                    uvec4 xq4_b = ldv4((tap_b + c) >> 4u);
                                    uint wb0 = w_tap_base + (c >> 2u);

                                    if (can_v16) {
                                        if (noc <= 4u) {
                                            DUAL_ACC_4_VEC(xq4_a, xq4_b, wb0 >> 2u, kw_stride);
                                        } else {
                                            DUAL_ACC_16_VEC(xq4_a, xq4_b, wb0 >> 2u, kw_stride);
                                        }
                                    } else {
                                        DUAL_ACC_16(xq4_a.x, xq4_b.x, wb0 + 0u);
                                        DUAL_ACC_16(xq4_a.y, xq4_b.y, wb0 + 1u);
                                        DUAL_ACC_16(xq4_a.z, xq4_b.z, wb0 + 2u);
                                        DUAL_ACC_16(xq4_a.w, xq4_b.w, wb0 + 3u);
                                    }
                                }
                            }

                            uint u32_a = tap_a >> 2u;
                            uint u32_b = tap_b >> 2u;
                            uint full_c = s0.c & ~3u;
                            for (; c < full_c; c += 4u) {
                                uint xq_a = arena_u32[u32_a + (c >> 2u)];
                                uint xq_b = arena_u32[u32_b + (c >> 2u)];
                                uint wb = w_tap_base + (c >> 2u);
                                DUAL_ACC_16(xq_a, xq_b, wb);
                            }

                            if (full_c < s0.c) {
                                uint rem_c = s0.c - full_c;
                                uint mask = (1u << (rem_c * 8u)) - 1u;
                                uint xq_a = arena_u32[u32_a + (full_c >> 2u)] & mask;
                                uint xq_b = arena_u32[u32_b + (full_c >> 2u)] & mask;
                                uint wb = w_tap_base + (full_c >> 2u);
                                DUAL_ACC_16(xq_a, xq_b, wb);
                            }
                        }
                    }
                }
            } else {
                for (int ky = 0; ky < kh; ++ky) {
                    int iy_a = iy0_a + ky * dil, iy_b = iy0_b + ky * dil;
                    for (int kx = 0; kx < kw; ++kx) {
                        int ix_a = ix0_a + kx * dil, ix_b = ix0_b + kx * dil;
                        uint tap = uint(ky * kw + kx);
                        uint w_tap_base = w_off + oc0 * kw_words + tap * icw;

                        uint gw_base = 0u;
                        for (uint si = 0u; si < nseg; ++si) {
                            Seg s = segAt(si);
                            bool inb_a = (iy_a >= 0 && iy_a < int(s.t.h) && ix_a >= 0 && ix_a < int(s.t.w));
                            bool inb_b = (has_b && iy_b >= 0 && iy_b < int(s.t.h) && ix_b >= 0 && ix_b < int(s.t.w));

                            if (inb_a || inb_b) {
                                uint safe_y_a = inb_a ? uint(iy_a) : 0u, safe_x_a = inb_a ? uint(ix_a) : 0u;
                                uint safe_y_b = inb_b ? uint(iy_b) : 0u, safe_x_b = inb_b ? uint(ix_b) : 0u;
                                uint srow_a = srcRow(s, row_a);
                                uint srow_b = has_b ? srcRow(s, row_b) : 0u;

                                uint byte_base_a = s.t.base + ((srow_a * s.t.h + safe_y_a) * s.t.w + safe_x_a) * s.t.c_alloc + s.c_off;
                                uint byte_base_b = s.t.base + ((srow_b * s.t.h + safe_y_b) * s.t.w + safe_x_b) * s.t.c_alloc + s.c_off;

                                uint c = 0u;
                                if ((byte_base_a & 15u) == 0u) {
                                    for (; c + 16u <= s.c; c += 16u) {
                                        uvec4 xq4_a = inb_a ? ldv4((byte_base_a + c) >> 4u) : uvec4(0u);
                                        uvec4 xq4_b = inb_b ? ldv4((byte_base_b + c) >> 4u) : uvec4(0u);
                                        uint wb0 = w_tap_base + gw_base + (c >> 2u);

                                        DUAL_ACC_16(xq4_a.x, xq4_b.x, wb0 + 0u);
                                        DUAL_ACC_16(xq4_a.y, xq4_b.y, wb0 + 1u);
                                        DUAL_ACC_16(xq4_a.z, xq4_b.z, wb0 + 2u);
                                        DUAL_ACC_16(xq4_a.w, xq4_b.w, wb0 + 3u);
                                    }
                                }

                                uint u32_base_a = byte_base_a >> 2u;
                                uint u32_base_b = byte_base_b >> 2u;
                                uint full_c = s.c & ~3u;
                                for (; c < full_c; c += 4u) {
                                    uint xq_a = inb_a ? arena_u32[u32_base_a + (c >> 2u)] : 0u;
                                    uint xq_b = inb_b ? arena_u32[u32_base_b + (c >> 2u)] : 0u;
                                    uint wb = w_tap_base + gw_base + (c >> 2u);
                                    DUAL_ACC_16(xq_a, xq_b, wb);
                                }

                                if (full_c < s.c) {
                                    uint rem_c = s.c - full_c;
                                    uint mask = (1u << (rem_c * 8u)) - 1u;
                                    uint xq_a = inb_a ? (arena_u32[u32_base_a + (full_c >> 2u)] & mask) : 0u;
                                    uint xq_b = inb_b ? (arena_u32[u32_base_b + (full_c >> 2u)] & mask) : 0u;
                                    uint wb = w_tap_base + gw_base + (full_c >> 2u);
                                    DUAL_ACC_16(xq_a, xq_b, wb);
                                }
                            }
                            gw_base += (s.c + 3u) / 4u;
                        }
                    }
                }
            }
        }
    }

                                                                        
    uint out_coff = opw(OP_OUT_COFF);
    int act = opi(5), res_t = opi(6), res_c = opi(7);
    uint so = opw(OP_SCALE_OFF), bo = opw(OP_BIAS_OFF);
    Tensor tr;
    uint rc0 = 0u;
    Seg sres;
    if (res_t >= 0) {
        tr = tensorAt(uint(res_t));
        rc0 = res_c >= 0 ? uint(res_c) : uint(-1 - res_c);
        sres.t = tr; sres.c_off = rc0; sres.c = tr.c; sres.swap = false;
    }

                                                                            
    vec4 sc0 = uintBitsToFloat(uvec4(blob[so + oc0 + 0u], blob[so + oc0 + 1u], blob[so + oc0 + 2u], blob[so + oc0 + 3u]));
    vec4 bi0 = uintBitsToFloat(uvec4(blob[bo + oc0 + 0u], blob[bo + oc0 + 1u], blob[bo + oc0 + 2u], blob[bo + oc0 + 3u]));
    vec4 sc1 = vec4(0.0), bi1 = vec4(0.0), sc2 = vec4(0.0), bi2 = vec4(0.0), sc3 = vec4(0.0), bi3 = vec4(0.0);
    if (noc > 4u) {
        sc1 = uintBitsToFloat(uvec4(blob[so + oc0 + 4u], blob[so + oc0 + 5u], blob[so + oc0 + 6u], blob[so + oc0 + 7u]));
        bi1 = uintBitsToFloat(uvec4(blob[bo + oc0 + 4u], blob[bo + oc0 + 5u], blob[bo + oc0 + 6u], blob[bo + oc0 + 7u]));
        sc2 = uintBitsToFloat(uvec4(blob[so + oc0 + 8u], blob[so + oc0 + 9u], blob[so + oc0 + 10u], blob[so + oc0 + 11u]));
        bi2 = uintBitsToFloat(uvec4(blob[bo + oc0 + 8u], blob[bo + oc0 + 9u], blob[bo + oc0 + 10u], blob[bo + oc0 + 11u]));
        sc3 = uintBitsToFloat(uvec4(blob[so + oc0 + 12u], blob[so + oc0 + 13u], blob[so + oc0 + 14u], blob[so + oc0 + 15u]));
        bi3 = uintBitsToFloat(uvec4(blob[bo + oc0 + 12u], blob[bo + oc0 + 13u], blob[bo + oc0 + 14u], blob[bo + oc0 + 15u]));
    }

                           

    EMIT_BLOCK4(0u, a0_0, a0_1, a0_2, a0_3, sc0, bi0, row_a, oy_a, ox_a);
    if (noc > 4u) {
        EMIT_BLOCK4(4u, a0_4, a0_5, a0_6, a0_7, sc1, bi1, row_a, oy_a, ox_a);
        EMIT_BLOCK4(8u, a0_8, a0_9, a0_10, a0_11, sc2, bi2, row_a, oy_a, ox_a);
        EMIT_BLOCK4(12u, a0_12, a0_13, a0_14, a0_15, sc3, bi3, row_a, oy_a, ox_a);
    }

    if (has_b) {
        EMIT_BLOCK4(0u, a1_0, a1_1, a1_2, a1_3, sc0, bi0, row_b, oy_b, ox_b);
        if (noc > 4u) {
            EMIT_BLOCK4(4u, a1_4, a1_5, a1_6, a1_7, sc1, bi1, row_b, oy_b, ox_b);
            EMIT_BLOCK4(8u, a1_8, a1_9, a1_10, a1_11, sc2, bi2, row_b, oy_b, ox_b);
            EMIT_BLOCK4(12u, a1_12, a1_13, a1_14, a1_15, sc3, bi3, row_b, oy_b, ox_b);
        }
    }
}
