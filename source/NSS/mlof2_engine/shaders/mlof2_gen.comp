            lgu = (1.0 - lb.y) * ((1.0 - lb.x) * tl[0] + lb.x * tl[1]) + lb.y * ((1.0 - lb.x) * tl[2] + lb.x * tl[3]);
            mm = (1.0 - lb.y) * ((1.0 - lb.x) * tk[0] + lb.x * tk[1]) + lb.y * ((1.0 - lb.x) * tk[2] + lb.x * tk[3]);
            if (bfOn) bfu = (1.0 - lb.y) * ((1.0 - lb.x) * tb[0] + lb.x * tb[1]) + lb.y * ((1.0 - lb.x) * tb[2] + lb.x * tb[3]);
        } else {
            fm = bilUp4(im, ox, oy, to.w, to.h) * 2.0; fo = bilUp4(io, ox, oy, to.w, to.h) * 2.0;
            oob = bilUp(im, ox, oy, to.w, to.h, 5u) > 0.5;
            lgu = bilUp4(lg, ox, oy, to.w, to.h); mm = bilUp(mk, ox, oy, to.w, to.h, 0u);
            if (bfOn) bfu = bilUp(mk, ox, oy, to.w, to.h, 1u);
        }
        vec2 fl[4] = vec2[4](fm.xy, fm.zw, fo.xy, fo.zw);
        vec3 cd[4];
#ifndef MLOF2_DX
        for (uint i = 0u; i < 4u; ++i) {
            bool off = offFrame(fl[i].x, fl[i].y, to.w, to.h);
            vec2 uv = (vec2(ox, oy) + fl[i] + 0.5) / vec2(to.w, to.h);
            vec4 b4 = (i & 1u) == 0u ? textureLod(uTexCabA, uv, 0.0) : textureLod(uTexCabB, uv, 0.0);
            for (uint c = 0u; c < 3u; ++c) cd[i][c] = off ? float(hashn(uint(ox), uint(oy), c, i)) / 4294967296.0 : b4[c];
        }
#else
        Seg ca = sub(cab, 0u, 3u), cb = sub(cab, 4u, 3u);
        for (uint i = 0u; i < 4u; ++i) {
            bool off = offFrame(fl[i].x, fl[i].y, to.w, to.h);
            vec4 b4 = bil4Z((i & 1u) == 0u ? ca : cb, float(ox) + fl[i].x, float(oy) + fl[i].y);
            for (uint c = 0u; c < 3u; ++c) cd[i][c] = off ? float(hashn(uint(ox), uint(oy), c, i)) / 4294967296.0 : b4[c];
        }
#endif
        vec4 w = softmax4(lgu);
        vec3 colr = clamp(w.x * cd[0] + w.y * cd[1] + w.z * cd[2] + w.w * cd[3], 0.0, 1.0);
        float s2 = max(w.x + w.y, 1e-6);
        bool offa = offFrame(fl[0].x, fl[0].y, to.w, to.h);
        vec3 mo = offa ? cd[1] : (oob ? cd[0] : (w.x / s2) * cd[0] + (w.y / s2) * cd[1]);
        vec3 col = (1.0 - mm) * mo + mm * colr;
        if (bfOn) {                                                                                                 
            vec3 near = fcf(FC_T) <= 0.5 ? cd[0] : cd[1];
            near = offa ? cd[1] : (oob ? cd[0] : near);
            if (opi(1) == 1 && !offa && !oob) {                                                                       
                float wv[4] = float[4](w.x, w.y, w.z, w.w);                                                         
                int ib = -1; float wb = -1.0;
                for (int i = 0; i < 4; ++i)
                    if (!offFrame(fl[i].x, fl[i].y, to.w, to.h) && wv[i] > wb) { ib = i; wb = wv[i]; }
                if (ib >= 0) near = cd[ib];
            }
            col = col + bfu * (near - col);
        }
        if (oob) {                                                                                               
            bool use_homog = (opw(OP_NSEG) >= 8u) && (segRead(segAt(7u), 0u, 0, 0, 9u) > 0.5);
            if (use_homog) {
                Seg ho = segAt(7u);
                mat3 H;
                H[0][0] = segRead(ho, 0u, 0, 0, 0u);
                H[0][1] = segRead(ho, 0u, 0, 0, 1u);
                H[0][2] = segRead(ho, 0u, 0, 0, 2u);
                H[1][0] = segRead(ho, 0u, 0, 0, 3u);
                H[1][1] = segRead(ho, 0u, 0, 0, 4u);
                H[1][2] = segRead(ho, 0u, 0, 0, 5u);
                H[2][0] = segRead(ho, 0u, 0, 0, 6u);
                H[2][1] = segRead(ho, 0u, 0, 0, 7u);
                H[2][2] = segRead(ho, 0u, 0, 0, 8u);

                float W_f = float(to.w), H_f = float(to.h);
                float X = (float(ox) + 0.5 - 0.5 * W_f) / W_f;
                float Y = (float(oy) + 0.5 - 0.5 * H_f) / W_f;
                vec3 Q = H * vec3(X, Y, 1.0);
                vec2 UV = Q.xy / max(abs(Q.z), 1e-7);
                float ox_new = UV.x * W_f + 0.5 * W_f;
                float oy_new = UV.y * W_f + 0.5 * H_f;

                if (ox_new >= 0.0 && ox_new < W_f && oy_new >= 0.0 && oy_new < H_f) {
                    vec2 uv2 = vec2(ox_new, oy_new) / vec2(to.w, to.h);
#ifndef MLOF2_DX
                    col = textureLod(uTexCabA, uv2, 0.0).xyz;
#else
                    Seg ca = sub(cab, 0u, 3u);
                    col = bil4Z(ca, ox_new - 0.5, oy_new - 0.5).xyz;
#endif
                }
            } else {
                bool hole2 = bilUp(ic, ox, oy, to.w, to.h, 2u) > 0.5;                                       
                vec2 to2 = vec2(bilUp(ic, ox, oy, to.w, to.h, 0u), bilUp(ic, ox, oy, to.w, to.h, 1u)) * 4.0;
#ifndef MLOF2_DX
                if (!hole2 && !offFrame(to2.x, to2.y, to.w, to.h)) {
                    vec2 uv2 = (vec2(ox, oy) + to2 + 0.5) / vec2(to.w, to.h);
                    col = textureLod(uTexCabA, uv2, 0.0).xyz;
                }
#else
                Seg ca = sub(cab, 0u, 3u);
                if (!hole2 && !offFrame(to2.x, to2.y, to.w, to.h)) col = bil4Z(ca, float(ox) + to2.x, float(oy) + to2.y).xyz;
#endif
            }
        }
        float V = vigV(vg, float(ox), float(oy), float(to.w), float(to.h));
        if (to.fmt == 0u && to.c_alloc == 3u) {
            uint w_base = (to.base >> 2u) + (uint(oy) * to.w + uint(ox)) * 3u;
            arena_u32[w_base + 0u] = floatBitsToUint(clamp(col.x * V, 0.0, 1.0));
            arena_u32[w_base + 1u] = floatBitsToUint(clamp(col.y * V, 0.0, 1.0));
            arena_u32[w_base + 2u] = floatBitsToUint(clamp(col.z * V, 0.0, 1.0));
            return;
        }
        if (to.fmt == 1u && to.c_alloc == 4u) {                                                            
            uint w_base = (to.base >> 2u) + (uint(oy) * to.w + uint(ox)) * 2u;
            vec3 o = clamp(col * V, 0.0, 1.0);
#ifndef MLOF2_DX
            if (fcf(FC_EXT_OUT) > 0.5) {                                                                          
                uint dw = uint(fcf(FC_EXT_DISP_W)), dh = uint(fcf(FC_EXT_DISP_H));
                if (uint(ox) >= dw || uint(oy) >= dh) return;
                vec3 rgb = clamp(vec3(unpackHalf2x16(packHalf2x16(o.xy)), unpackHalf2x16(packHalf2x16(vec2(o.z, 0.0))).x), 0.0, 1.0);
                uint hm = uint(fcf(FC_EXT_HUD));
                if (hm != 0u) {
                    vec3 fullColor = texelFetch(uExtFull, ivec2(ox, oy), 0).rgb;
                    vec3 sceneColor = texelFetch(uExtColB, ivec2(ox, oy), 0).rgb;
                    vec3 tolerance = hm == 2u ? abs(sceneColor) * vec3(1.0 / 64.0, 1.0 / 64.0, 1.0 / 32.0) + vec3(1.0 / 255.0)
                                              : vec3(1.0 / 4096.0);
                    if (any(greaterThan(abs(fullColor - sceneColor), tolerance))) rgb = fullColor;
                }
                imageStore(uExtOut, ivec2(ox, oy), vec4(rgb, 1.0));
                return;
            }
#endif
            arena_u32[w_base] = packHalf2x16(o.xy);
            arena_u32[w_base + 1u] = packHalf2x16(vec2(o.z, 0.0));
            return;
        }
        for (uint c = 0u; c < 3u; ++c) put(c, clamp(col[c] * V, 0.0, 1.0));
    } else if (IS(K_TRAIL_SEL)) {
        Seg cl = segAt(0u), cv = segAt(1u), i2 = segAt(2u), om = segAt(3u);
        bool use = segRead(om, 0u, oy, ox, 0u) > 0.5 && segRead(i2, 0u, oy, ox, 4u) < 0.5 &&
                   !offFrame(segRead(i2, 0u, oy, ox, 2u), segRead(i2, 0u, oy, ox, 3u), to.w, to.h);
        for (uint c = 0u; c < 3u; ++c) put(c, use ? segRead(cv, 0u, oy, ox, c) : segRead(cl, 0u, oy, ox, c));
    
    }

    if (out_coff + out_c == to.c) wzeroPad(to, 0u, oy, ox);
    wflush();
#endif
}
