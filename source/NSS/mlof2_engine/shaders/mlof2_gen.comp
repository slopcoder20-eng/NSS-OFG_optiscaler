vec2 extMvPrevAt(int X, int Y) {
    uint mw = uint(fcf(FC_EXT_MV_W)), mh = uint(fcf(FC_EXT_MV_H));
    ivec2 t = extTexel(X, Y, mw, mh);
    uint b = floatBitsToUint(fcf(FC_EXT_MVAP_OFF)) + (uint(t.y) * mw + uint(t.x)) * 2u;
    return vec2(uintBitsToFloat(arena_u32[b]), uintBitsToFloat(arena_u32[b + 1u]));
}
                                                               
vec2 extMvPrevBil(float u, float v, uint w, uint h) {
    float x0f = floor(u), y0f = floor(v), ax = u - x0f, ay = v - y0f;
    int x0 = int(x0f), y0 = int(y0f);
    vec2 r = vec2(0.0);
    for (int j = 0; j < 4; ++j) {
        int px = x0 + (j & 1), py = y0 + (j >> 1);
        if (px >= 0 && py >= 0 && px < int(w) && py < int(h))
            r += ((j & 1) != 0 ? ax : 1.0 - ax) * ((j >> 1) != 0 ? ay : 1.0 - ay) * extMvPrevAt(px, py);
    }
    return r;
}
                                                                                                                    
                                                                                                                      
