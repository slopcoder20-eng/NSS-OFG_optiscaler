float lum3(Seg s, int y, int x) {
    return 0.299 * segRead(s, 0u, y, x, 0u) + 0.587 * segRead(s, 0u, y, x, 1u) + 0.114 * segRead(s, 0u, y, x, 2u);
}
void vfeat(float X, float Y, float W, float H, out float f0, out float f1, out float f2) {
    float dx = clamp(2.0 * X / (W - 1.0) - 1.0, -1.0, 1.0), dy = clamp(2.0 * Y / (H - 1.0) - 1.0, -1.0, 1.0);
    float fx = dx * dx;
    f0 = dx < 0.0 ? fx : 0.0; f1 = dx >= 0.0 ? fx : 0.0; f2 = dy * dy;
}
                                                         
float vigV(Seg vg, float X, float Y, float W, float H) {
    float f0, f1, f2; vfeat(X, Y, W, H, f0, f1, f2);
    uint vg_base = vg.t.base >> 2u;
    float c12 = uintBitsToFloat(arena_u32[vg_base + 12u]);
    float c13 = uintBitsToFloat(arena_u32[vg_base + 13u]);
    float c14 = uintBitsToFloat(arena_u32[vg_base + 14u]);
    return exp(f0 * c12 + f1 * c13 + f2 * c14);
}
uint hashn(uint x, uint y, uint c, uint idx) {                                                 
    uint h = x * 1973u + y * 9277u + c * 26699u + idx * 7919u + 12345u;
    h = (h ^ (h >> 16)) * 0x7feb352du;
    h = (h ^ (h >> 15)) * 0x846ca68bu;
    return h ^ (h >> 16);
}
bool offFrameAt(int x, int y, float fx, float fy, uint w, uint h) {
    float qx = float(x) + fx, qy = float(y) + fy;
    return qx < -0.5 || qx > float(w) - 0.5 || qy < -0.5 || qy > float(h) - 0.5;
}
                                                                                                        
float bilUp(Seg s, int x, int y, uint w, uint h, uint c) {
    float fy = max((float(y) + 0.5) * float(s.t.h) / float(h) - 0.5, 0.0), fx = max((float(x) + 0.5) * float(s.t.w) / float(w) - 0.5, 0.0);
    int y0 = int(fy), x0 = int(fx), y1 = min(y0 + 1, int(s.t.h) - 1), x1 = min(x0 + 1, int(s.t.w) - 1);
    float ly = fy - float(y0), lx = fx - float(x0);
    return (1.0 - ly) * ((1.0 - lx) * segRead(s, 0u, y0, x0, c) + lx * segRead(s, 0u, y0, x1, c)) +
           ly * ((1.0 - lx) * segRead(s, 0u, y1, x0, c) + lx * segRead(s, 0u, y1, x1, c));
}
                                                                                                        
void upAt(uint cw, uint chh, int x, int y, uint w, uint h, out ivec2 p0, out ivec2 p1, out vec2 l) {
    float fy = max((float(y) + 0.5) * float(chh) / float(h) - 0.5, 0.0), fx = max((float(x) + 0.5) * float(cw) / float(w) - 0.5, 0.0);
    p0 = ivec2(int(fx), int(fy)); p1 = ivec2(min(p0.x + 1, int(cw) - 1), min(p0.y + 1, int(chh) - 1));
    l = vec2(fx - float(p0.x), fy - float(p0.y));
}
                                                       
bool segWords(Seg s) { return s.t.fmt == 1u && ((s.c_off | s.t.c_alloc) & 1u) == 0u && (s.t.base & 3u) == 0u; }
                                               
vec4 bilUp4(Seg s, int x, int y, uint w, uint h) {
    float fy = max((float(y) + 0.5) * float(s.t.h) / float(h) - 0.5, 0.0), fx = max((float(x) + 0.5) * float(s.t.w) / float(w) - 0.5, 0.0);
    int y0 = int(fy), x0 = int(fx), y1 = min(y0 + 1, int(s.t.h) - 1), x1 = min(x0 + 1, int(s.t.w) - 1);
    float ly = fy - float(y0), lx = fx - float(x0);
    return (1.0 - ly) * ((1.0 - lx) * segRead4(s, 0u, y0, x0, 0u) + lx * segRead4(s, 0u, y0, x1, 0u)) +
           ly * ((1.0 - lx) * segRead4(s, 0u, y1, x0, 0u) + lx * segRead4(s, 0u, y1, x1, 0u));
}
bool offFrame(float fx, float fy, uint w, uint h) {
    float qx = float(ox) + fx, qy = float(oy) + fy;
    return qx < -0.5 || qx > float(w) - 0.5 || qy < -0.5 || qy > float(h) - 0.5;
}
                                                                                                         
bool g_accel; float g_t;
vec2 dispAt(Seg f, Seg fbp, int y, int x) {
    bool adj = g_accel && fbp.t.base == f.t.base && fbp.c_off == f.c_off + 2u;                                 
    vec4 v4 = adj ? segRead4(f, 0u, y, x, 0u) : vec4(segRead2(f, 0u, y, x, 0u), 0.0, 0.0);
    vec2 a0 = v4.xy;
    vec2 d = (1.0 - g_t) * a0;
    if (g_accel) {
        vec2 a = (adj ? v4.zw : segRead2(fbp, 0u, y, x, 0u)) - 2.0 * a0;
        float cap = 0.5 * length(a0);
        a *= min(cap / max(length(a), 1e-6), 1.0);
        d += 0.5 * a * g_t * (g_t - 1.0);
    }
    return d;
}
                                                                                                             
int g_cstep = 1;                                                                                          
vec2 camAt(Seg nd, int y, int x) {
    int cw = int(nd.t.w) / g_cstep, chh = int(nd.t.h) / g_cstep;
    bool in_ = x >= 0 && y >= 0 && x < cw && y < chh;                                          
    float W = float(cw), H = float(chh), t = fcf(FC_T);
#ifndef MLOF2_DX
    float zn = extIn() ? extNdcA(4 * (clamp(x, 0, cw - 1) * g_cstep) + 1, 4 * (clamp(y, 0, chh - 1) * g_cstep) + 1)                                
                       : segRead(nd, 0u, clamp(y, 0, chh - 1) * g_cstep, clamp(x, 0, cw - 1) * g_cstep, 0u);
#else
    float zn = segRead(nd, 0u, clamp(y, 0, chh - 1) * g_cstep, clamp(x, 0, cw - 1) * g_cstep, 0u);
#endif
    float cl[4] = float[4]((float(x) + 0.5) / W * 2.0 - 1.0, -((float(y) + 0.5) / H * 2.0 - 1.0), zn, 1.0);
    float wd[4];
    for (int j = 0; j < 4; ++j) { float a = 0.0; for (int i = 0; i < 4; ++i) a += cl[i] * fcf(FC_INV_VP_A + uint(i * 4 + j)); wd[j] = a; }
    float c4[4];
    for (int j = 0; j < 4; ++j) {
        float a = 0.0;
        for (int i = 0; i < 4; ++i) a += wd[i] * ((1.0 - t) * fcf(FC_VP_A + uint(i * 4 + j)) + t * fcf(FC_VP_B + uint(i * 4 + j)));
        c4[j] = a;
    }
    vec2 r = vec2((c4[0] / c4[3] + 1.0) / 2.0 * W - 0.5 - float(x), (-c4[1] / c4[3] + 1.0) / 2.0 * H - 0.5 - float(y));
    return in_ ? r : vec2(0.0);
}
ivec2 nearestB(vec2 q, uint w, uint h) { return clamp(ivec2(roundEven(q)), ivec2(0), ivec2(int(w) - 1, int(h) - 1)); }

                                                                                                           
vec4 bil4Z(Seg s, float u, float v) {
    float x0f = floor(u), y0f = floor(v), ax = u - x0f, ay = v - y0f;
    int x0 = int(x0f), y0 = int(y0f);
    if (seg4h(s, 0u)) {                                                                                                     
        int W = int(s.t.w), H = int(s.t.h);
        float wx0 = x0 >= 0 && x0 < W ? 1.0 - ax : 0.0, wx1 = x0 + 1 >= 0 && x0 + 1 < W ? ax : 0.0;
        float wy0 = y0 >= 0 && y0 < H ? 1.0 - ay : 0.0, wy1 = y0 + 1 >= 0 && y0 + 1 < H ? ay : 0.0;
        int xa = clamp(x0, 0, W - 1), xb = clamp(x0 + 1, 0, W - 1), ya = clamp(y0, 0, H - 1), yb = clamp(y0 + 1, 0, H - 1);
        vec4 t00 = segLd4h(s, 0u, ya, xa, 0u), t01 = segLd4h(s, 0u, ya, xb, 0u);
        vec4 t10 = segLd4h(s, 0u, yb, xa, 0u), t11 = segLd4h(s, 0u, yb, xb, 0u);
        return wy0 * (wx0 * t00 + wx1 * t01) + wy1 * (wx0 * t10 + wx1 * t11);
    }
    vec4 r = vec4(0.0);
    for (int j = 0; j < 4; ++j) {
        int px = x0 + (j & 1), py = y0 + (j >> 1);
        if (px < 0 || py < 0 || px >= int(s.t.w) || py >= int(s.t.h)) continue;
        r += ((j & 1) != 0 ? ax : 1.0 - ax) * ((j >> 1) != 0 ? ay : 1.0 - ay) * segRead4(s, 0u, py, px, 0u);
    }
    return r;
}
Seg sub(Seg s, uint c0, uint c) { s.c_off += c0; s.c = c; return s; }                                
                                                                                                                 
                                                                                                                          
                                                                                                          
vec2 ofUpAt(Seg s, int X, int Y, uint w, uint h) {
    float fy = max((float(Y) + 0.5) * float(s.t.h) / float(h) - 0.5, 0.0), fx = max((float(X) + 0.5) * float(s.t.w) / float(w) - 0.5, 0.0);
    int y0 = int(fy), x0 = int(fx), y1 = min(y0 + 1, int(s.t.h) - 1), x1 = min(x0 + 1, int(s.t.w) - 1);
    float ly = fy - float(y0), lx = fx - float(x0);
    vec2 a, b, c, d;
    if (s.t.fmt == 0u && s.t.c_alloc == 2u) {
        uint u_base = s.t.base >> 2u;
        uint r0 = uint(y0) * s.t.w, r1 = uint(y1) * s.t.w;
        uint ia = u_base + (r0 + uint(x0)) * 2u;
        uint ib = u_base + (r0 + uint(x1)) * 2u;
        uint ic = u_base + (r1 + uint(x0)) * 2u;
        uint id = u_base + (r1 + uint(x1)) * 2u;
        a = vec2(uintBitsToFloat(arena_u32[ia]), uintBitsToFloat(arena_u32[ia + 1u]));
        b = vec2(uintBitsToFloat(arena_u32[ib]), uintBitsToFloat(arena_u32[ib + 1u]));
        c = vec2(uintBitsToFloat(arena_u32[ic]), uintBitsToFloat(arena_u32[ic + 1u]));
        d = vec2(uintBitsToFloat(arena_u32[id]), uintBitsToFloat(arena_u32[id + 1u]));
    } else {
        a = vec2(segRead(s, 0u, y0, x0, 0u), segRead(s, 0u, y0, x0, 1u));
        b = vec2(segRead(s, 0u, y0, x1, 0u), segRead(s, 0u, y0, x1, 1u));
        c = vec2(segRead(s, 0u, y1, x0, 0u), segRead(s, 0u, y1, x0, 1u));
        d = vec2(segRead(s, 0u, y1, x1, 0u), segRead(s, 0u, y1, x1, 1u));
    }
    return ((1.0 - ly) * ((1.0 - lx) * a + lx * b) + ly * ((1.0 - lx) * c + lx * d)) * (float(w) / float(s.t.w));
}
                                                                                                       
vec2 warpUpZ(Seg s, float u, float v, uint w, uint h) {
    float x0f = floor(u), y0f = floor(v), ax = u - x0f, ay = v - y0f;
    int x0 = int(x0f), y0 = int(y0f);
    vec2 r = vec2(0.0);
    for (int j = 0; j < 4; ++j) {
        int px = x0 + (j & 1), py = y0 + (j >> 1);
        bool in_ = px >= 0 && py >= 0 && px < int(w) && py < int(h);
        float wt = in_ ? ((j & 1) != 0 ? ax : 1.0 - ax) * ((j >> 1) != 0 ? ay : 1.0 - ay) : 0.0;
        r += wt * ofUpAt(s, clamp(px, 0, int(w) - 1), clamp(py, 0, int(h) - 1), w, h);
    }
    return r;
}
vec2 bil2Z(Seg s, float u, float v) {
    float x0f = floor(u), y0f = floor(v), ax = u - x0f, ay = v - y0f;
    int x0 = int(x0f), y0 = int(y0f), W = int(s.t.w), H = int(s.t.h);
    vec2 r = vec2(0.0);
    bool is_fp0_c2 = (s.t.fmt == 0u && s.t.c_alloc == 2u);
    bool is_fp1_c2 = (s.t.fmt == 1u && s.t.c_alloc == 2u);
    uint u_base = s.t.base >> 2u;
    for (int j = 0; j < 4; ++j) {
        int px = x0 + (j & 1), py = y0 + (j >> 1);
        if (px >= 0 && py >= 0 && px < W && py < H) {
            float wt = ((j & 1) != 0 ? ax : 1.0 - ax) * ((j >> 1) != 0 ? ay : 1.0 - ay);
            vec2 val;
            if (is_fp0_c2) {
                uint idx = u_base + (uint(py) * s.t.w + uint(px)) * 2u;
                val = vec2(uintBitsToFloat(arena_u32[idx]), uintBitsToFloat(arena_u32[idx + 1u]));
            } else if (is_fp1_c2) {
                uint idx = u_base + uint(py) * s.t.w + uint(px);
                val = unpackHalf2x16(arena_u32[idx]);
            } else {
                val = vec2(segRead(s, 0u, py, px, 0u), segRead(s, 0u, py, px, 1u));
            }
            r += wt * val;
        }
    }
    return r;
}
                                                                                                                   
vec4 softmax4(vec4 l) { float mx = max(max(l.x, l.y), max(l.z, l.w)); vec4 e = exp(l - mx); return e / (e.x + e.y + e.z + e.w); }
float qMoLuma(Seg lg, Seg qc, int x, int y) {
    vec4 w = softmax4(segRead4(lg, 0u, y, x, 0u));
    vec4 c0 = segRead4(qc, 0u, y, x, 0u), c1 = segRead4(qc, 0u, y, x, 4u);
    vec3 a = c0.xyz, b = vec3(c0.w, c1.x, c1.y);
    vec2 ma = vec2(segRead(qc, 0u, y, x, 12u), segRead(qc, 0u, y, x, 13u));
    bool offa = offFrameAt(x, y, ma.x, ma.y, qc.t.w, qc.t.h), oob = segRead(qc, 0u, y, x, 22u) > 0.5;
    float s2 = max(w.x + w.y, 1e-6);
    vec3 mo = offa ? b : (oob ? a : (w.x / s2) * a + (w.y / s2) * b);
    return dot(mo, vec3(0.299, 0.587, 0.114));
}
bool qOne(Seg qc, int x, int y) {
    vec2 ma = vec2(segRead(qc, 0u, y, x, 12u), segRead(qc, 0u, y, x, 13u));
    return offFrameAt(x, y, ma.x, ma.y, qc.t.w, qc.t.h) || segRead(qc, 0u, y, x, 22u) > 0.5;
}
                                                                                                                  
float qBothFail(Seg r1, float med, int x, int y, float bm, float bw) {
    vec4 r = segRead4(r1, 0u, y, x, 0u);
    float k = r.z + med + 1e-3;
    return 1.0 / (1.0 + exp(-((min(r.x, r.y) - bm * k) / (bw * k))));
}
float qScore(Seg r1, float med, int x, int y) {
    vec4 r = segRead4(r1, 0u, y, x, 0u);                                              
    float k = r.z + med + 1e-3;
    return 1.0 / (1.0 + exp(-((r.x - r.y - 0.5 * k) / (0.25 * k))));
}

                                                                                                
void invertT(Seg f, Seg fbp, bool useV, Seg vs, out float r[6]) {
    uint w = f.t.w, h = f.t.h;
    vec2 yv = vec2(float(ox), float(oy));
    vec2 q = yv - dispAt(f, fbp, oy, ox);
    for (int k = 0; k < 4; ++k) { ivec2 p = nearestB(q, w, h); q = yv - dispAt(f, fbp, p.y, p.x); }
    ivec2 pq = nearestB(q, w, h);
    vec2 rr = abs(q + dispAt(f, fbp, pq.y, pq.x) - yv);
    bool inb = q.x >= 0.0 && q.x <= float(w) - 1.0 && q.y >= 0.0 && q.y <= float(h) - 1.0;
    bool val = !useV || segRead(vs, 0u, pq.y, pq.x, 0u) > 0.5;
    bool good = max(rr.x, rr.y) <= 1.0 && inb && val;
    bool oob = q.x < -0.5 || q.x > float(w) - 0.5 || q.y < -0.5 || q.y > float(h) - 0.5;
    vec2 q0 = floor(q), wq = q - q0;
    vec2 fx = vec2(0.0), dx = vec2(0.0);
    for (int j = 0; j < 4; ++j) {
        int px = int(q0.x) + (j & 1), py = int(q0.y) + (j >> 1);
        bool in_ = px >= 0 && py >= 0 && px < int(w) && py < int(h);                                   
        float wt = in_ ? ((j & 1) != 0 ? wq.x : 1.0 - wq.x) * ((j >> 1) != 0 ? wq.y : 1.0 - wq.y) : 0.0;
        px = clamp(px, 0, int(w) - 1); py = clamp(py, 0, int(h) - 1);
        fx += wt * segRead2(f, 0u, py, px, 0u);
        dx += wt * dispAt(f, fbp, py, px);
    }
    r[0] = fx.x - dx.x; r[1] = fx.y - dx.y; r[2] = -dx.x; r[3] = -dx.y; r[4] = good ? 0.0 : 1.0; r[5] = oob ? 1.0 : 0.0;
}

                                        
void camInvert(Seg nd, out float r[6]) {
    uint w = nd.t.w / uint(g_cstep), h = nd.t.h / uint(g_cstep);
    vec2 yv = vec2(float(ox), float(oy));
    vec2 q = yv - camAt(nd, oy, ox);
    for (int k = 0; k < 4; ++k) { ivec2 p = nearestB(q, w, h); q = yv - camAt(nd, p.y, p.x); }
    ivec2 pq = nearestB(q, w, h);
    vec2 rr = abs(q + camAt(nd, pq.y, pq.x) - yv);
    bool inb = q.x >= 0.0 && q.x <= float(w) - 1.0 && q.y >= 0.0 && q.y <= float(h) - 1.0;
    bool good = max(rr.x, rr.y) <= 1.0 && inb;
    bool oob = q.x < -0.5 || q.x > float(w) - 0.5 || q.y < -0.5 || q.y > float(h) - 0.5;
    vec2 q0 = floor(q), wq = q - q0;
    vec2 fx = vec2(0.0);
    for (int j = 0; j < 4; ++j) {
        int px = int(q0.x) + (j & 1), py = int(q0.y) + (j >> 1);
        bool in_ = px >= 0 && py >= 0 && px < int(w) && py < int(h);                                   
        float wt = in_ ? ((j & 1) != 0 ? wq.x : 1.0 - wq.x) * ((j >> 1) != 0 ? wq.y : 1.0 - wq.y) : 0.0;
        px = clamp(px, 0, int(w) - 1); py = clamp(py, 0, int(h) - 1);
        fx += wt * camAt(nd, py, px);
    }
    r[0] = 0.0; r[1] = 0.0; r[2] = -fx.x; r[3] = -fx.y; r[4] = good ? 0.0 : 1.0; r[5] = oob ? 1.0 : 0.0;
}

                                                                                                         
                                      
void candAt(Seg pf, Seg inv, int X, int Y, out float c[12]) {
    uint w = pf.t.w, h = pf.t.h;
    for (uint i = 0u; i < 4u; ++i) {
        uint f0 = (i < 2u ? 0u : 6u) + (i & 1u) * 2u, s0 = (i & 1u) * 3u;
        float fxv = segRead(inv, 0u, Y, X, f0), fyv = segRead(inv, 0u, Y, X, f0 + 1u);
        bool off = offFrameAt(X, Y, fxv, fyv, w, h);
        for (uint k = 0u; k < 3u; ++k)
            c[3u * i + k] = off ? float(hashn(uint(X), uint(Y), k, i)) / 4294967296.0
                                : segBilinearZ(pf, 0u, float(X) + fxv, float(Y) + fyv, s0 + k);
    }
}

void main() {
    uint kind = opw(OP_KIND);
#ifdef MLOF2_GEN_RED
#ifndef MLOF2_DX
                                                                           
                                            
    if (MLOF2_RED_KIND >= 0) kind = uint(MLOF2_RED_KIND);
#endif
#endif
    to = outAt();
    out_coff = opw(OP_OUT_COFF);
    uint out_c = opw(OP_OUT_C);
    uint gid = gl_GlobalInvocationID.x, lid = gl_LocalInvocationID.x;

#ifdef MLOF2_GEN_RED
    if (IS(K_VIG_PART)) {                                                                                          
        if (fcf(FC_PAIR_FIRST) == 0.0) return;
        Seg ca = segAt(0u), cb = segAt(1u), mv = segAt(2u), mvv = segAt(3u);
        uint gw = (ca.t.w + 3u) / 4u, gh = (ca.t.h + 3u) / 4u;
        float v[13];
        for (int i = 0; i < 13; ++i) v[i] = 0.0;
        if (gid < gw * gh) {
            const bool lane = mv.t.w != ca.t.w;                                                                          
            int gx_ = int(gid % gw), gy_ = int(gid / gw);
            int X = gx_ * 4 + (lane ? 1 : 0), Y = gy_ * 4 + (lane ? 1 : 0);
            int MX = lane ? 2 * gx_ : X, MY = lane ? 2 * gy_ : Y;
            float W = float(ca.t.w), H = float(ca.t.h);
            float mx, my, vv;
#ifndef MLOF2_DX
            if (extIn()) { vec2 em = extMvAt(X, Y); mx = em.x; my = em.y; vv = 1.0; } else
#endif
            { mx = segRead(mv, 0u, MY, MX, 0u); my = segRead(mv, 0u, MY, MX, 1u); vv = segRead(mvv, 0u, MY, MX, 0u); }
            float sx = float(X) + mx, sy = float(Y) + my;
            bool ok = vv > 0.5 && sx >= 1.0 && sx <= W - 2.0 && sy >= 1.0 && sy <= H - 2.0 &&
                      length(vec2(mx, my)) > 30.0;
            if (ok) {
                float la, lb;
#ifndef MLOF2_DX
                if (extIn()) {
                    vec3 ba = extColABil(sx, sy, ca.t.w, ca.t.h), cbv = extCol(true, X, Y);
                    la = 0.299 * ba.x + 0.587 * ba.y + 0.114 * ba.z;
                    lb = 0.299 * cbv.x + 0.587 * cbv.y + 0.114 * cbv.z;
                } else
#endif
                {
                    la = 0.299 * segBilinearZ(ca, 0u, sx, sy, 0u) + 0.587 * segBilinearZ(ca, 0u, sx, sy, 1u) + 0.114 * segBilinearZ(ca, 0u, sx, sy, 2u);
                    lb = lum3(cb, Y, X);
                }
                float r = log(max(lb, 1e-6)) - log(max(la, 1e-6));
                ok = la > 0.03 && lb > 0.03 && abs(r) < 0.5;
                if (ok) {
                    float a0, a1, a2, b0, b1, b2;
                    vfeat(float(X), float(Y), W, H, a0, a1, a2); vfeat(sx, sy, W, H, b0, b1, b2);
                    float R[3] = float[3](a0 - b0, a1 - b1, a2 - b2);
                    for (int i = 0; i < 3; ++i) { for (int j = 0; j < 3; ++j) v[i * 3 + j] = R[i] * R[j]; v[9 + i] = R[i] * r; }
                    v[12] = 1.0;
                }
            }
        }
        for (int i = 0; i < 13; ++i) sh_red[lid * 13u + uint(i)] = v[i];
        barrier();
        for (uint s = 32u; s > 0u; s >>= 1) {
            if (lid < s) for (uint i = 0u; i < 13u; ++i) sh_red[lid * 13u + i] += sh_red[(lid + s) * 13u + i];
            barrier();
        }
        if (lid == 0u) for (uint i = 0u; i < 13u; ++i) tensorWrite(to, 0u, 0, int(gl_WorkGroupID.x), i, sh_red[i]);
        return;
    }
    if (IS(K_VIG_SOLVE)) {
        if (fcf(FC_PAIR_FIRST) == 0.0) return;
        Seg vp = segAt(0u);
        uint ng = (vp.t.w * vp.t.h + 63u) / 64u;

        float s_loc[13];
        for (int i = 0; i < 13; ++i) s_loc[i] = 0.0;

        uint step_w = vp.t.c_alloc * 2u;
        for (uint g = lid; g < ng; g += 64u) {
            uint u = (vp.t.base + g * step_w) >> 2u;
            vec2 v0 = unpackHalf2x16(arena_u32[u]);
            vec2 v1 = unpackHalf2x16(arena_u32[u + 1u]);
            vec2 v2 = unpackHalf2x16(arena_u32[u + 2u]);
            vec2 v3 = unpackHalf2x16(arena_u32[u + 3u]);
            vec2 v4 = unpackHalf2x16(arena_u32[u + 4u]);
            vec2 v5 = unpackHalf2x16(arena_u32[u + 5u]);
            float v6 = unpackHalf2x16(arena_u32[u + 6u]).x;
            s_loc[0] += v0.x; s_loc[1] += v0.y;
            s_loc[2] += v1.x; s_loc[3] += v1.y;
            s_loc[4] += v2.x; s_loc[5] += v2.y;
            s_loc[6] += v3.x; s_loc[7] += v3.y;
            s_loc[8] += v4.x; s_loc[9] += v4.y;
            s_loc[10] += v5.x; s_loc[11] += v5.y;
            s_loc[12] += v6;
        }

        for (int i = 0; i < 13; ++i) sh_red[lid * 13u + uint(i)] = s_loc[i];
        barrier();
        for (uint s = 32u; s > 0u; s >>= 1) {
            if (lid < s) {
                for (uint i = 0u; i < 13u; ++i) sh_red[lid * 13u + i] += sh_red[(lid + s) * 13u + i];
            }
            barrier();
        }
        if (lid != 0u) return;

        float s[13];
        for (int i = 0; i < 13; ++i) s[i] = sh_red[i];
                                                                        
        float A[9], b[3];
        for (uint i = 0u; i < 9u; ++i) A[i] = 0.85 * tensorRead(to, 0u, 0, 0, i);
        for (uint i = 0u; i < 3u; ++i) b[i] = 0.85 * tensorRead(to, 0u, 0, 0, 9u + i);
        if (s[12] > 64.0) {
            float w = 1e4 / s[12];
            for (int i = 0; i < 9; ++i) A[i] += w * s[i];
            for (int i = 0; i < 3; ++i) b[i] += w * s[9 + i];
        }
        for (uint i = 0u; i < 9u; ++i) tensorWrite(to, 0u, 0, 0, i, A[i]);
        for (uint i = 0u; i < 3u; ++i) tensorWrite(to, 0u, 0, 0, 9u + i, b[i]);
        float rr = max(1e-6 * (A[0] + A[4] + A[8]) / 3.0, 1e-9);
        bool fr[3] = bool[3](true, true, true);
        float lv[3] = float[3](0.0, 0.0, 0.0);
        for (int it = 0; it < 3; ++it) {
                                                                                        
            float M[9], y[3]; int id[3]; int n = 0;
            for (int i = 0; i < 3; ++i) if (fr[i]) id[n++] = i;
            for (int i = 0; i < n; ++i) { y[i] = b[id[i]]; for (int j = 0; j < n; ++j) M[i * 3 + j] = A[id[i] * 3 + id[j]] + (i == j ? rr : 0.0); }
            for (int c = 0; c < n; ++c) {
                int p = c; for (int r2 = c + 1; r2 < n; ++r2) if (abs(M[r2 * 3 + c]) > abs(M[p * 3 + c])) p = r2;
                if (p != c) { for (int j = 0; j < n; ++j) { float tmp = M[c * 3 + j]; M[c * 3 + j] = M[p * 3 + j]; M[p * 3 + j] = tmp; } float ty = y[c]; y[c] = y[p]; y[p] = ty; }
                for (int r2 = c + 1; r2 < n; ++r2) { float f = M[r2 * 3 + c] / M[c * 3 + c]; for (int j = c; j < n; ++j) M[r2 * 3 + j] -= f * M[c * 3 + j]; y[r2] -= f * y[c]; }
            }
            float xs[3];
            for (int c = n - 1; c >= 0; --c) { float a = y[c]; for (int j = c + 1; j < n; ++j) a -= M[c * 3 + j] * xs[j]; xs[c] = a / M[c * 3 + c]; }
            for (int i = 0; i < 3; ++i) lv[i] = 0.0;
            bool any = false;
            for (int i = 0; i < n; ++i) { lv[id[i]] = xs[i]; if (xs[i] > 0.0) any = true; }
            if (!any) break;
            for (int i = 0; i < 3; ++i) if (fr[i] && lv[i] > 0.0) fr[i] = false;
        }
        for (uint i = 0u; i < 3u; ++i) tensorWrite(to, 0u, 0, 0, 12u + i, lv[i]);
        return;
    }
    if (IS(K_RESIZE_AREA)) {                                                                                        
        Seg sa = segAt(0u);                                                                                      
        int f = int(to.s / sa.t.s);
        uint orow = gl_WorkGroupID.x / (to.w * to.h), orem = gl_WorkGroupID.x - orow * to.w * to.h;
        int oyy = int(orem / to.w), oxx = int(orem - (orem / to.w) * to.w);
        vec4 a4 = vec4(0.0);
        for (int r = int(lid); r < f; r += 64)
            for (int x = 0; x < f; ++x)
                for (uint c = 0u; c < out_c; ++c) a4[c] += segRead(sa, orow, oyy * f + r, oxx * f + x, c);
        for (uint c = 0u; c < 4u; ++c) sh_red[lid * 13u + c] = a4[c];
        barrier();
        for (uint st = 32u; st > 0u; st >>= 1) {
            if (lid < st) for (uint c = 0u; c < 4u; ++c) sh_red[lid * 13u + c] += sh_red[(lid + st) * 13u + c];
            barrier();
        }
        if (lid == 0u) {
            for (uint c = 0u; c < out_c; ++c) wput(to, orow, oyy, oxx, out_coff + c, sh_red[c] / float(f * f));
            if (out_coff + out_c == to.c) wzeroPad(to, orow, oyy, oxx);
            wflush();
        }
        return;
    }
    if (IS(K_MEDIAN_HIST)) {                                                                                                  
                                                                               
        Seg a = segAt(0u);
        uint N = a.t.w * a.t.h, hb = to.base >> 2u;                                                                    
        for (uint i = lid; i < 4096u; i += 64u) sh_hist[i] = 0u;
        barrier();
        uint p0 = gl_WorkGroupID.x * 2048u;
        for (uint i = p0 + lid; i < min(p0 + 2048u, N); i += 64u) {
            float v = clamp(segRead(a, 0u, int(i / a.t.w), int(i % a.t.w), 0u), 0.0, 1.0);
            atomicAdd(sh_hist[min(uint(v * 4096.0), 4095u)], 1u);
        }
        barrier();
        for (uint i = lid; i < 4096u; i += 64u) if (sh_hist[i] != 0u) atomicAdd(arena_u32[hb + i], sh_hist[i]);
        return;
    }
    if (IS(K_MEDIAN_PICK)) {                                                                             
        if (gl_WorkGroupID.x != 0u) return;
        Seg hs = segAt(0u), a = segAt(1u);
        uint N = a.t.w * a.t.h, hb = hs.t.base >> 2u;
        uint part = 0u;
        for (uint i = 0u; i < 64u; ++i) part += arena_u32[hb + lid * 64u + i];
        sh_hist[lid] = part;
        barrier();
        if (lid == 0u) {
            uint k = (N - 1u) / 2u, cum = 0u, bsel = 4095u;
            for (uint g = 0u; g < 64u; ++g) {
                if (cum + sh_hist[g] >= k + 1u) {
                    for (uint i = 0u; i < 64u; ++i) { cum += arena_u32[hb + g * 64u + i]; if (cum >= k + 1u) { bsel = g * 64u + i; break; } }
                    break;
                }
                cum += sh_hist[g];
            }
            s_med = (float(bsel) + 0.5) / 4096.0;
        }
        barrier();
        float med = s_med;
        for (uint i = lid; i < to.w * to.h; i += 64u) tensorWrite(to, 0u, int(i / to.w), int(i % to.w), out_coff, med);
        return;
    }
    if (IS(K_MEDIAN)) {                                                                               
        if (gl_WorkGroupID.x != 0u) return;
        Seg a = segAt(0u);
        uint N = a.t.w * a.t.h;
        for (uint i = lid; i < 4096u; i += 64u) sh_hist[i] = 0u;
        barrier();
        for (uint i = lid; i < N; i += 64u) {                                                                       
            float v = clamp(segRead(a, 0u, int(i / a.t.w), int(i % a.t.w), 0u), 0.0, 1.0);
            atomicAdd(sh_hist[min(uint(v * 4096.0), 4095u)], 1u);
        }
        barrier();
        if (lid == 0u) {
            uint k = (N - 1u) / 2u, cum = 0u, bsel = 4095u;
            for (uint i = 0u; i < 4096u; ++i) { cum += sh_hist[i]; if (cum >= k + 1u) { bsel = i; break; } }
            s_med = (float(bsel) + 0.5) / 4096.0;
        }
        barrier();
        float med = s_med;
        uint total_out = to.w * to.h;
        for (uint i = lid; i < total_out; i += 64u) tensorWrite(to, 0u, int(i / to.w), int(i % to.w), out_coff, med);
        return;
    }

    if (IS(K_HOMOG_ACC)) {
                                                                                                          
        Seg qc = segAt(0u);                                                
        Seg ic = segAt(1u);                                      
        bool has_h = (opw(OP_NSEG) >= 3u);
        Seg h_prev;
        if (has_h) h_prev = segAt(2u);

                              
        if (lid < 64u) sh_hist[lid] = 0u;
        for (uint i = 0u; i < 45u; ++i) {
            sh_hist[64u + lid * 45u + i] = 0u;
        }
        barrier();

        uint N = qc.t.w * qc.t.h;
        if (gid < N) {
            int ox_q = int(gid % qc.t.w);
            int oy_q = int(gid / qc.t.w);

            float oob_mv = segRead(qc, 0u, oy_q, ox_q, 22u);
            bool is_band = (oob_mv > 0.5);

            bool is_ring = false;
            vec2 mv = vec2(0.0), cam = vec2(0.0);
            if (!is_band) {
                float hole_mv = segRead(qc, 0u, oy_q, ox_q, 20u);
                if (hole_mv < 0.5) {
                    mv = vec2(segRead(qc, 0u, oy_q, ox_q, 12u), segRead(qc, 0u, oy_q, ox_q, 13u)) * 4.0;
                    if (!offFrame(mv.x, mv.y, qc.t.w * 4u, qc.t.h * 4u)) {
                        cam = vec2(segRead(ic, 0u, oy_q, ox_q, 0u), segRead(ic, 0u, oy_q, ox_q, 1u)) * 4.0;
                                                                            
                        for (int dx = -12; dx <= 12; dx += 3) {
                            int sx = ox_q + dx;
                            if (sx >= 0 && sx < int(qc.t.w)) {
                                if (segRead(qc, 0u, oy_q, sx, 22u) > 0.5) { is_ring = true; break; }
                            }
                        }
                        if (!is_ring) {
                            for (int dy = -12; dy <= 12; dy += 3) {
                                int sy = oy_q + dy;
                                if (sy >= 0 && sy < int(qc.t.h)) {
                                    if (segRead(qc, 0u, sy, ox_q, 22u) > 0.5) { is_ring = true; break; }
                                }
                            }
                        }
                    }
                }
            }

            if (is_ring) {
                float diff = length(cam - mv);
                uint b = clamp(uint(diff), 0u, 63u);
                atomicAdd(sh_hist[b], 1u);

                float W_full = float(qc.t.w * 4u);
                float H_full = float(qc.t.h * 4u);
                float X = (float(ox_q * 4) + 2.0 - 0.5 * W_full) / W_full;
                float Y = (float(oy_q * 4) + 2.0 - 0.5 * H_full) / W_full;
                float U = X + mv.x / W_full;
                float V = Y + mv.y / W_full;

                float w = 1.0;
                if (has_h) {
                    mat3 H_mat;
                    H_mat[0][0] = segRead(h_prev, 0u, 0, 0, 0u);
                    H_mat[0][1] = segRead(h_prev, 0u, 0, 0, 1u);
                    H_mat[0][2] = segRead(h_prev, 0u, 0, 0, 2u);
                    H_mat[1][0] = segRead(h_prev, 0u, 0, 0, 3u);
                    H_mat[1][1] = segRead(h_prev, 0u, 0, 0, 4u);
                    H_mat[1][2] = segRead(h_prev, 0u, 0, 0, 5u);
                    H_mat[2][0] = segRead(h_prev, 0u, 0, 0, 6u);
                    H_mat[2][1] = segRead(h_prev, 0u, 0, 0, 7u);
                    H_mat[2][2] = 1.0;

                    vec3 Q = H_mat * vec3(X, Y, 1.0);
                    vec2 pred_UV = Q.xy / max(abs(Q.z), 1e-7);
                    float res_px = length(pred_UV - vec2(U, V)) * W_full;
                    w = (res_px < 3.0) ? 1.0 : (1.7320508075688772 * inversesqrt(res_px));
                }

                float r1[8] = float[8](X, Y, 1.0, 0.0, 0.0, 0.0, -U * X, -U * Y);
                float r2[8] = float[8](0.0, 0.0, 0.0, X, Y, 1.0, -V * X, -V * Y);

                int idx = 0;
                for (int i = 0; i < 8; ++i) {
                    for (int j = i; j < 8; ++j) {
                        float term = w * (r1[i] * r1[j] + r2[i] * r2[j]);
                        sh_hist[64u + lid * 45u + uint(idx++)] = floatBitsToUint(term);
                    }
                }
                for (int i = 0; i < 8; ++i) {
                    float term = w * (r1[i] * U + r2[i] * V);
                    sh_hist[64u + lid * 45u + 36u + uint(i)] = floatBitsToUint(term);
                }
                sh_hist[64u + lid * 45u + 44u] = floatBitsToUint(1.0);
            }
        }
        barrier();

                                      
        for (uint s = 32u; s > 0u; s >>= 1) {
            if (lid < s) {
                uint base_dst = 64u + lid * 45u;
                uint base_src = 64u + (lid + s) * 45u;
                for (uint i = 0u; i < 45u; ++i) {
                    float va = uintBitsToFloat(sh_hist[base_dst + i]);
                    float vb = uintBitsToFloat(sh_hist[base_src + i]);
                    sh_hist[base_dst + i] = floatBitsToUint(va + vb);
                }
            }
            barrier();
        }

                                                                                   
        uint wg_idx = gl_WorkGroupID.x;
        uint base_u32 = (to.base >> 2u) + wg_idx * to.c_alloc;
        if (lid < 45u) {
            arena_u32[base_u32 + lid] = sh_hist[64u + lid];
        }
        if (lid < 64u) {
            arena_u32[base_u32 + 45u + lid] = floatBitsToUint(float(sh_hist[lid]));
        }
        return;
    }

    if (IS(K_HOMOG_SOLVE)) {
