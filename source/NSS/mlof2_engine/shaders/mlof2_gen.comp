ivec2 extTexel(int X, int Y, uint tw, uint th) {
    uint dw = uint(fcf(FC_EXT_DISP_W)), dh = uint(fcf(FC_EXT_DISP_H));
    uint cx = min(uint(max(X, 0)), dw - 1u), cy = min(uint(max(Y, 0)), dh - 1u);
    return ivec2(min(uint((float(cx) + 0.5) * float(tw) / float(dw)), tw - 1u), min(uint((float(cy) + 0.5) * float(th) / float(dh)), th - 1u));
}
