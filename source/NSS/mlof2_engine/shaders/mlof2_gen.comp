bool extIn() { return fcf(FC_EXT_IN) > 0.5; }
float h16(float x) { return unpackHalf2x16(packHalf2x16(vec2(x, 0.0))).x; }
vec3 extCol(bool b, int X, int Y) {
    uint dw = uint(fcf(FC_EXT_DISP_W)), dh = uint(fcf(FC_EXT_DISP_H));
    ivec2 p = ivec2(min(uint(max(X, 0)), dw - 1u), min(uint(max(Y, 0)), dh - 1u));
    vec3 c = b ? texelFetch(uExtColB, p, 0).rgb : texelFetch(uExtColA, p, 0).rgb;
    return vec3(h16(c.r), h16(c.g), h16(c.b));
}
vec2 extMvAt(int X, int Y) {                                                       
    ivec2 t = extTexel(X, Y, uint(fcf(FC_EXT_MV_W)), uint(fcf(FC_EXT_MV_H)));
    return texelFetch(uExtMv, t, 0).xy * vec2(fcf(FC_EXT_MV_SX), fcf(FC_EXT_MV_SY));
}
float extRawDepth(bool b, int X, int Y) {
    ivec2 t = extTexel(X, Y, uint(fcf(FC_EXT_DEP_W)), uint(fcf(FC_EXT_DEP_H)));
    return b ? texelFetch(uExtDepB, t, 0).r : texelFetch(uExtDepA, t, 0).r;
}
float extDepFeat(bool b, int X, int Y) {
    float raw = extRawDepth(b, X, Y);
    float d = fcf(FC_EXT_REVZ) > 0.5 ? (1.0 - raw) : raw;
    d = clamp(d, 0.0, 1.0 - 1e-6);
    return clamp(-log2(max(1.0 - d, 1e-6)) / 16.0, 0.0, 1.0);
}
float extNdcA(int X, int Y) {
    float raw = extRawDepth(false, X, Y);
    return fcf(FC_EXT_REVZ) > 0.5 ? clamp(raw, 0.0, 1.0) : (1.0 - clamp(raw, 0.0, 1.0));
}
                                                                                                    
vec3 extColABil(float u, float v, uint w, uint h) {
    float x0f = floor(u), y0f = floor(v), ax = u - x0f, ay = v - y0f;
    int x0 = int(x0f), y0 = int(y0f);
    vec3 c[4];
    for (int j = 0; j < 4; ++j) {
        int px = x0 + (j & 1), py = y0 + (j >> 1);
        c[j] = (px >= 0 && py >= 0 && px < int(w) && py < int(h)) ? extCol(false, px, py) : vec3(0.0);
    }
    return (1.0 - ay) * ((1.0 - ax) * c[0] + ax * c[1]) + ay * ((1.0 - ax) * c[2] + ax * c[3]);
}
